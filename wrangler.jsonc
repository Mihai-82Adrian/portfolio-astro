{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-astro",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2025-11-14",
  "vars": {
    "NODE_VERSION": "24.19.0"
  },
  "env": {
    // "vars" is non-inheritable in Pages, so preview and production declare NODE_VERSION
    // explicitly. Remote Cloudflare activation/parity is controlled separately; see
    // docs/operations/cloudflare-pages-configuration.md.
    "preview": {
      "vars": {
        "NODE_VERSION": "24.19.0"
      }
    },
    "production": {
      "vars": {
        "NODE_VERSION": "24.19.0"
      }
    }
  }
}
