# Cloudflare Pages Headers Configuration
# Configures static asset caching and HTTP security perimeter headers

# Cache static assets (images, fonts, etc.) for 1 year
/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS and JS for 1 year (with content hash in filename)
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# HTML files - cache for 1 hour, revalidate
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Root HTML - cache for 1 hour, revalidate
/
  Cache-Control: public, max-age=3600, must-revalidate

# Blog pages - cache for 1 hour
/blog/*
  Cache-Control: public, max-age=3600, must-revalidate

# WebP images - cache for 1 year
/*.webp
  Cache-Control: public, max-age=31536000, immutable

# SVG images - cache for 1 year
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# /_astro/* must never inherit a custom Cache-Control. Cloudflare Pages
# _headers splats match greedily across path separators, so every generic
# extension rule above (/*.css, /*.js, /*.webp, /*.svg) also matches
# /_astro/*.js, /_astro/*.css, etc. Empirically verified against real
# Cloudflare Pages preview deployments (not just documentation): when two
# matching rules touch the same header, the LAST one in file order wins —
# an earlier-listed detach does NOT defeat a later-listed set. This block
# must therefore stay positioned after every rule above that can set
# Cache-Control for a /_astro/* path; moving any such rule below this point
# would silently re-poison /_astro/* with an immutable Cache-Control again.
# Absent this detach, a transiently cached HTML/error response under a
# hashed module path could stay "immutable" for a year at both edge and
# browser (the incident this guards against). Cloudflare Pages' own default
# asset caching (ETag revalidation, scoped to files that actually exist in
# the deployment) already gives hash-named build output effectively
# permanent, but safely revalidatable, caching without this footgun.
/_astro/*
  ! Cache-Control

# Favicon - cache for 1 week
/favicon.ico
  Cache-Control: public, max-age=604800

# Manifest - cache for 1 week
/site.webmanifest
  Cache-Control: public, max-age=604800

# Sitemap - cache for 1 day
/sitemap*.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

# Robots.txt - cache for 1 day
/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# Security headers for all pages
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Reporting-Endpoints: csp-endpoint="/api/csp-report"
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://analytics.ahrefs.com https://cloudflareinsights.com https://challenges.cloudflare.com; script-src 'self' 'unsafe-inline' https://analytics.ahrefs.com https://giscus.app https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; frame-src https://giscus.app https://www.youtube-nocookie.com https://open.spotify.com https://challenges.cloudflare.com; media-src 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests; report-uri /api/csp-report; report-to csp-endpoint
