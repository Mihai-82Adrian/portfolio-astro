# Netlify/Cloudflare Pages Redirects
# Blog and Projects are English-only, redirect EN/RO to main (DE) version

# Exact redirects first
/en/blog           /blog            301
/ro/blog           /blog            301
/en/projects       /projects        301
/ro/projects       /projects        301

# Splat redirects after exact matches
/en/blog/*         /blog/:splat     301
/ro/blog/*         /blog/:splat     301
/en/projects/*     /projects/:splat 301
/ro/projects/*     /projects/:splat 301
