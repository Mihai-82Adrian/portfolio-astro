---
import Icon from '@components/ui/Icon.astro';
import tokens from '../../data/design-tokens.json';
import type { Language } from '@utils/i18n';

// Props (optional customization)
interface Props {
  privacyPolicyUrl?: string;
  lang?: Language;
}

const { privacyPolicyUrl = '/datenschutz', lang = 'de' } = Astro.props;

const copy = {
  de: {
    title: 'Datenschutz-Einstellungen',
    description: 'Notwendige Einstellungen (Theme, Sprache) werden immer lokal gespeichert. Ahrefs Web Analytics ist optional und läuft nur, wenn du zustimmst.',
    learnMore: 'Mehr zum Datenschutz',
    learnMoreAria: 'Mehr über Datenschutz und Analyse-Einstellungen erfahren',
    accept: 'Analyse zulassen',
    reject: 'Nur Notwendiges',
  },
  en: {
    title: 'Privacy settings',
    description: 'Necessary preferences (theme, language) are always stored locally. Ahrefs Web Analytics is optional and only runs if you agree.',
    learnMore: 'Learn more about privacy',
    learnMoreAria: 'Learn more about privacy and analytics settings',
    accept: 'Allow analytics',
    reject: 'Essential only',
  },
  ro: {
    title: 'Setări de confidențialitate',
    description: 'Preferințele necesare (temă, limbă) sunt salvate mereu local. Ahrefs Web Analytics este opțional și pornește doar dacă ești de acord.',
    learnMore: 'Mai multe despre confidențialitate',
    learnMoreAria: 'Află mai multe despre confidențialitate și setările de analiză',
    accept: 'Permite analiza',
    reject: 'Doar necesare',
  },
}[lang];
---

<div id="cookie-consent-banner" class="cookie-banner" hidden>
  <div class="cookie-content">
    <div class="cookie-icon" aria-hidden="true">
      <Icon name="cookie" class="h-6 w-6" />
    </div>
    <div class="cookie-text">
      <p class="cookie-title">{copy.title}</p>
      <p class="cookie-description">
        {copy.description}
        <a
          href={privacyPolicyUrl}
          class="cookie-link"
          aria-label={copy.learnMoreAria}
        >
          {copy.learnMore}
        </a>
      </p>
    </div>
  </div>
  <div class="cookie-actions">
    <button id="reject-analytics" class="btn-reject" type="button">
      {copy.reject}
    </button>
    <button id="accept-analytics" class="btn-accept" type="button">
      {copy.accept}
    </button>
  </div>
</div>

<script>
  import { readPreferences, writePreferences } from '@/lib/consent';

  const banner = document.getElementById('cookie-consent-banner');
  const acceptBtn = document.getElementById('accept-analytics');
  const rejectBtn = document.getElementById('reject-analytics');

  function showBanner() {
    if (!banner) return;
    banner.hidden = false;
    // Force reflow to trigger transition
    void banner.offsetWidth;
    banner.classList.add('visible');
  }

  function hideBanner() {
    if (!banner) return;
    banner.classList.remove('visible');
    // Wait for animation to finish before hiding
    setTimeout(() => {
      banner.hidden = true;
    }, 400);
  }

  const prefs = readPreferences(window.localStorage);
  if (!prefs.decided) {
    setTimeout(showBanner, 1000);
  }

  acceptBtn?.addEventListener('click', () => {
    writePreferences(true, window.localStorage);
    hideBanner();
  });

  rejectBtn?.addEventListener('click', () => {
    writePreferences(false, window.localStorage);
    hideBanner();
  });

  // Reopened later via the "Privacy settings" control in the footer, to allow
  // withdrawing analytics consent at any time.
  window.addEventListener('open-privacy-preferences', showBanner);
</script>

<style define:vars={{
    colorBg: tokens.colors.light.bg,
    colorText: tokens.colors.text.primary.light,
    colorTextSec: tokens.colors.text.secondary.light,
    colorAccent: tokens.colors.eucalyptus[700],
    colorAccentHover: tokens.colors.eucalyptus[800]
  }}>
  .cookie-banner {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: min(calc(100% - 4rem), 400px);
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: rgba(var(--color-bg-rgb), 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    z-index: 100;
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cookie-banner.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* Specific dark mode adjustments for the glass effect */
  :global(.dark) .cookie-banner {
    background: rgba(20, 20, 20, 0.6);
    border-color: rgba(255, 255, 255, 0.05);
  }

  .cookie-content {
    display: flex;
    min-width: 0;
    gap: 1rem;
    align-items: flex-start;
  }

  .cookie-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--colorAccent);
    margin-top: 0.25rem;
  }

  .cookie-text {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .cookie-title {
    font-weight: 700;
    font-size: 1rem;
    margin: 0 0 0.25rem;
    color: var(--colorText);
  }

  .cookie-description {
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
    color: var(--colorTextSec);
  }

  .cookie-link {
    color: var(--colorAccent);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .cookie-link:hover {
    border-color: currentColor;
  }

  .cookie-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    min-width: 0;
    justify-content: flex-end;
  }

  .btn-accept,
  .btn-reject {
    padding: 0.625rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  .btn-accept {
    background: var(--colorAccent);
    color: white;
    border: none;
  }

  .btn-accept:hover {
    background: var(--colorAccentHover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(var(--color-accent-rgb), 0.3);
  }

  .btn-accept:active {
    transform: translateY(0);
  }

  .btn-reject {
    background: transparent;
    color: var(--colorText);
    border: 1px solid color-mix(in srgb, var(--colorText) 25%, transparent);
  }

  .btn-reject:hover {
    border-color: var(--colorAccent);
    color: var(--colorAccent);
  }

  @media (max-width: 640px) {
    .cookie-banner {
      bottom: 1rem;
      right: 1rem;
      left: 1rem;
      width: auto;
      max-height: calc(100dvh - 2rem);
    }
  }
</style>
