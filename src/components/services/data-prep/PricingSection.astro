---
import Container from '@components/ui/Container.astro';
import type { LandingPageContent } from '@data/services/data-prep-for-ai';

interface Props {
  content: LandingPageContent['pricing'];
}

const { content } = Astro.props;
---

<section>
  <Container maxWidth="lg" paddingY="lg">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tight text-text-primary-light dark:text-text-primary-dark sm:text-4xl">
        {content.title}
      </h2>
      <p class="mt-4 text-pretty text-lg leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
        {content.intro}
      </p>
    </div>

    <div class="mt-8 grid gap-6">
      <div class="overflow-hidden rounded-3xl border border-black/10 bg-[var(--bg-elevated)] dark:border-white/10">
        <div class="overflow-x-auto">
          <table class="min-w-[56rem] w-full border-collapse text-left">
            <thead>
              <tr class="border-b border-black/10 bg-eucalyptus-50/70 dark:border-white/10 dark:bg-eucalyptus-950/20">
                <th class="p-4 text-sm font-semibold text-text-primary-light dark:text-text-primary-dark">
                  {content.tableHeaders.service}
                </th>
                <th class="p-4 text-sm font-semibold text-text-primary-light dark:text-text-primary-dark">
                  {content.tableHeaders.entryPoint}
                </th>
                <th class="p-4 text-sm font-semibold text-text-primary-light dark:text-text-primary-dark">
                  {content.tableHeaders.suitableFor}
                </th>
                <th class="p-4 text-sm font-semibold text-text-primary-light dark:text-text-primary-dark">
                  {content.tableHeaders.scopeOutcome}
                </th>
              </tr>
            </thead>
            <tbody>
              {content.tiers.map((tier) => (
                <tr class="border-b border-black/10 last:border-b-0 dark:border-white/10">
                  <th scope="row" class="w-[14rem] p-4 align-top text-sm font-semibold text-text-primary-light dark:text-text-primary-dark">
                    <div>{tier.name}</div>
                    <div class="mt-2 text-xs font-medium tracking-[0.16em] text-eucalyptus-700 dark:text-eucalyptus-300">
                      {tier.duration}
                    </div>
                  </th>
                  <td class="w-[10rem] p-4 align-top text-base font-semibold text-eucalyptus-700 dark:text-eucalyptus-300">
                    {tier.price}
                  </td>
                  <td class="p-4 align-top text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
                    {tier.description}
                  </td>
                  <td class="p-4 align-top text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
                    <ul class="space-y-2">
                      {tier.scope.map((item) => (
                        <li class="flex items-start gap-2">
                          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-eucalyptus-500" aria-hidden="true"></span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                    {tier.note && (
                      <p class="mt-3 text-xs leading-relaxed text-text-muted-light dark:text-text-muted-dark">
                        {tier.note}
                      </p>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="grid gap-0 overflow-hidden rounded-3xl border border-black/10 bg-[var(--bg-elevated)] dark:border-white/10 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="border-b border-black/10 p-6 dark:border-white/10 lg:border-b-0 lg:border-r">
          <h3 class="text-lg font-semibold text-text-primary-light dark:text-text-primary-dark">
            {content.notesTitle}
          </h3>
          <ul class="mt-4 space-y-3">
            {content.notes.map((note) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
                <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-eucalyptus-500" aria-hidden="true"></span>
                <span>{note}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-6">
          <h3 class="text-lg font-semibold text-text-primary-light dark:text-text-primary-dark">
            {content.rationaleTitle}
          </h3>
          <ul class="mt-4 space-y-3">
            {content.premiumRationale.map((item) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
                <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-eucalyptus-500" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>
