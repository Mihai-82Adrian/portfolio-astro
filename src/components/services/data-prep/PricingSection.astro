---
import Container from '@components/ui/Container.astro';
import Card from '@components/ui/Card.astro';
import type { LandingPageContent } from '@data/services/data-prep-for-ai';

interface Props {
  content: LandingPageContent['pricing'];
}

const { content } = Astro.props;
---

<section>
  <Container maxWidth="lg" paddingY="lg">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tight text-text-primary-light dark:text-text-primary-dark sm:text-4xl">
        {content.title}
      </h2>
      <p class="mt-4 text-pretty text-lg leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
        {content.intro}
      </p>
    </div>

    <div class="mt-8 grid gap-6">
      <div class="grid gap-4 xl:grid-cols-2">
        {content.tiers.map((tier) => (
          <Card class="h-full">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h3 class="text-xl font-semibold text-text-primary-light dark:text-text-primary-dark">
                  {tier.name}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
                  {tier.description}
                </p>
              </div>
              <p class="shrink-0 text-lg font-bold text-eucalyptus-700 dark:text-eucalyptus-300">
                {tier.price}
              </p>
            </div>

            <div class="mt-5 grid gap-4 sm:grid-cols-[1.2fr_0.8fr]">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-eucalyptus-700 dark:text-eucalyptus-300">
                  Scope
                </p>
                <ul class="mt-3 space-y-2">
                  {tier.scope.map((item) => (
                    <li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
                      <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-eucalyptus-500" aria-hidden="true"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="rounded-xl border border-black/10 bg-[var(--bg-surface)] p-4 dark:border-white/10 dark:bg-dark-surface">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-eucalyptus-700 dark:text-eucalyptus-300">
                  Dauer
                </p>
                <p class="mt-2 text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
                  {tier.duration}
                </p>
                {tier.note && (
                  <p class="mt-4 text-xs leading-relaxed text-text-muted-light dark:text-text-muted-dark">
                    {tier.note}
                  </p>
                )}
              </div>
            </div>
          </Card>
        ))}
      </div>

      <Card>
        <h3 class="text-lg font-semibold text-text-primary-light dark:text-text-primary-dark">
          Preislogik
        </h3>
        <ul class="mt-4 space-y-3">
          {content.notes.map((note) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
              <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-eucalyptus-500" aria-hidden="true"></span>
              <span>{note}</span>
            </li>
          ))}
        </ul>
      </Card>

      <Card>
        <h3 class="text-lg font-semibold text-text-primary-light dark:text-text-primary-dark">
          Warum dieser Preisrahmen sinnvoll ist
        </h3>
        <div class="mt-4 flex flex-wrap gap-2">
          {content.premiumRationale.map((item) => (
            <span class="inline-flex rounded-full border border-eucalyptus-500/20 bg-eucalyptus-50 px-3 py-1 text-sm text-eucalyptus-700 dark:border-eucalyptus-400/20 dark:bg-eucalyptus-950/35 dark:text-eucalyptus-300">
              {item}
            </span>
          ))}
        </div>
      </Card>
    </div>
  </Container>
</section>
