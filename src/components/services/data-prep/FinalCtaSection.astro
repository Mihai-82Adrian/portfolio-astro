---
import Button from '@components/ui/Button.astro';
import Container from '@components/ui/Container.astro';
import Card from '@components/ui/Card.astro';
import type { LandingPageContent } from '@data/services/data-prep-for-ai';

interface Props {
  content: LandingPageContent['finalCta'];
}

const { content } = Astro.props;
---

<section>
  <Container maxWidth="lg" paddingY="lg">
    <Card class="overflow-hidden">
      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-text-primary-light dark:text-text-primary-dark sm:text-4xl">
            {content.title}
          </h2>
          <p class="mt-4 max-w-2xl text-pretty text-lg leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
            {content.body}
          </p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <Button href={content.primaryCta.href} variant="primary" size="lg">
              {content.primaryCta.label}
            </Button>
            <Button href={content.secondaryCta.href} variant="outline" size="lg">
              {content.secondaryCta.label}
            </Button>
          </div>
        </div>

        <div class="rounded-2xl border border-eucalyptus-500/20 bg-[linear-gradient(180deg,rgba(107,142,111,0.08),rgba(107,142,111,0.02))] p-5 dark:border-eucalyptus-400/20">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-eucalyptus-700 dark:text-eucalyptus-300">
            Next step
          </p>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
            {content.microcopy}
          </p>
        </div>
      </div>
    </Card>
  </Container>
</section>
