---
import Container from '@components/ui/Container.astro';
import Card from '@components/ui/Card.astro';
import type { LandingPageContent } from '@data/services/data-prep-for-ai';

interface Props {
  content: LandingPageContent['services'];
}

const { content } = Astro.props;
---

<section>
  <Container maxWidth="lg" paddingY="lg">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tight text-text-primary-light dark:text-text-primary-dark sm:text-4xl">
        {content.title}
      </h2>
      <p class="mt-4 text-pretty text-lg leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
        {content.intro}
      </p>
    </div>

    <Card class="mt-8 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-[52rem] w-full border-collapse text-left">
          <thead>
            <tr class="border-b border-light-border dark:border-dark-border">
              <th class="p-4 font-semibold text-text-primary-light dark:text-text-primary-dark">
                Richtung
              </th>
              <th class="p-4 font-semibold text-text-primary-light dark:text-text-primary-dark">
                Problem
              </th>
              <th class="p-4 font-semibold text-text-primary-light dark:text-text-primary-dark">
                Prozess
              </th>
              <th class="p-4 font-semibold text-text-primary-light dark:text-text-primary-dark">
                Output
              </th>
            </tr>
          </thead>
          <tbody>
            {content.rows.map((row) => (
              <tr class="border-b border-light-border last:border-b-0 dark:border-dark-border">
                <th scope="row" class="p-4 align-top font-medium text-text-primary-light dark:text-text-primary-dark">
                  {row.direction}
                </th>
                <td class="p-4 align-top text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
                  {row.problem}
                </td>
                <td class="p-4 align-top text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
                  {row.process}
                </td>
                <td class="p-4 align-top text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
                  {row.output}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Card>

    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {content.details.map((detail) => (
        <Card padding="sm">
          <h3 class="text-base font-semibold text-text-primary-light dark:text-text-primary-dark">
            {detail.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
            {detail.description}
          </p>
        </Card>
      ))}
    </div>
  </Container>
</section>
