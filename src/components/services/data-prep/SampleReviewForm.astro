---
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import type { SampleReviewContent } from '@data/services/data-prep-for-ai';
import { FEATURE_CONTROLS } from '../../../../functions/_lib/feature-controls.ts';

interface Props {
  content: SampleReviewContent['form'];
}

const { content } = Astro.props;

// Phase 2D-C Wave 1 / Decision 3 (HIDE-FROM-LAUNCH): render a static, non-JS-dependent
// disabled notice instead of the live form whenever the feature is off, using the same
// compiled default the Function reads (functions/_lib/feature-controls.ts). This must
// stay in sync manually if a future wave introduces a per-environment runtime override —
// the static build cannot see request-time env vars.
const isEnabled = FEATURE_CONTROLS.SAMPLE_REVIEW_ENABLED;
---

<Card class="border-black/10 dark:border-white/10">
  <div class="grid gap-6 lg:grid-cols-[0.92fr_1.08fr]">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-eucalyptus-700 dark:text-eucalyptus-300">
        {content.title}
      </p>
      <p class="mt-4 text-pretty text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
        {content.intro}
      </p>

      <div class="mt-6 rounded-2xl border border-black/10 bg-[var(--bg-surface)] p-4 dark:border-white/10 dark:bg-dark-surface">
        <p class="text-sm font-semibold text-text-primary-light dark:text-text-primary-dark">
          {content.sendTitle}
        </p>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
          {content.sendItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="mt-4 rounded-2xl border border-black/10 bg-[var(--bg-surface)] p-4 dark:border-white/10 dark:bg-dark-surface">
        <p class="text-sm font-semibold text-text-primary-light dark:text-text-primary-dark">
          {content.doNotSendTitle}
        </p>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
          {content.doNotSendItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <p class="mt-6 text-sm leading-relaxed text-text-muted-light dark:text-text-muted-dark">
        {content.securityNote}
      </p>
    </div>

    {!isEnabled && (
      <div
        class="flex flex-col justify-center gap-4 rounded-2xl border border-amber-500/40 bg-amber-500/10 p-6 text-sm leading-relaxed text-amber-900 dark:border-amber-400/30 dark:bg-amber-400/10 dark:text-amber-200"
        data-sample-review-disabled-notice
      >
        <p class="font-semibold">{content.disabledNotice}</p>
        <Button href="mailto:kontakt@me-mateescu.de" variant="secondary" size="md" class="w-fit">
          kontakt@me-mateescu.de
        </Button>
      </div>
    )}

    {isEnabled && (
    <form
      method="POST"
      action="/api/sample-review"
      class="space-y-5 rounded-2xl border border-black/10 bg-[var(--bg-elevated)] p-5 dark:border-white/10"
      data-sample-review-form
    >
      {content.fields.map((field) => {
        if (field.type === 'hidden') {
          return (
            <input
              type="hidden"
              name={field.name}
              value={field.value ?? ''}
              tabindex={field.name === 'website' ? '-1' : undefined}
              autocomplete={field.name === 'website' ? 'off' : undefined}
              aria-hidden="true"
              data-submitted-at={field.name === 'submittedAt' ? 'true' : undefined}
            />
          );
        }

        return (
          <div class="space-y-2">
            <label
              for={field.name}
              class="text-sm font-medium text-text-primary-light dark:text-text-primary-dark"
            >
              {field.label}
              {field.required && <span class="ml-1 text-eucalyptus-700 dark:text-eucalyptus-300">*</span>}
            </label>

            {field.type === 'textarea' ? (
              <textarea
                id={field.name}
                name={field.name}
                required={field.required}
                placeholder={field.placeholder}
                rows="5"
                class="w-full rounded-xl border border-border-color bg-[var(--bg-primary)] px-4 py-3 text-sm text-text-primary-light shadow-sm outline-none transition-colors placeholder:text-text-tertiary-light focus:border-eucalyptus-500 focus:ring-2 focus:ring-eucalyptus-500/20 dark:border-dark-border dark:bg-dark-elevated dark:text-text-primary-dark dark:placeholder:text-text-tertiary-dark"
              />
            ) : field.type === 'select' ? (
              <select
                id={field.name}
                name={field.name}
                required={field.required}
                autocomplete={field.autocomplete}
                class="w-full rounded-xl border border-border-color bg-[var(--bg-primary)] px-4 py-3 text-sm text-text-primary-light shadow-sm outline-none transition-colors focus:border-eucalyptus-500 focus:ring-2 focus:ring-eucalyptus-500/20 dark:border-dark-border dark:bg-dark-elevated dark:text-text-primary-dark"
              >
                <option value="">{content.selectPlaceholder}</option>
                {field.options?.map((option) => <option value={option}>{option}</option>)}
              </select>
            ) : (
              <input
                id={field.name}
                type={field.type}
                name={field.name}
                required={field.required}
                placeholder={field.placeholder}
                autocomplete={field.autocomplete}
                class="w-full rounded-xl border border-border-color bg-[var(--bg-primary)] px-4 py-3 text-sm text-text-primary-light shadow-sm outline-none transition-colors placeholder:text-text-tertiary-light focus:border-eucalyptus-500 focus:ring-2 focus:ring-eucalyptus-500/20 dark:border-dark-border dark:bg-dark-elevated dark:text-text-primary-dark dark:placeholder:text-text-tertiary-dark"
              />
            )}

            {field.helpText && (
              <p class="text-xs leading-relaxed text-text-muted-light dark:text-text-muted-dark">
                {field.helpText}
              </p>
            )}
          </div>
        );
      })}

      <div class="rounded-2xl border border-black/10 bg-[var(--bg-surface)] p-4 dark:border-white/10 dark:bg-dark-surface">
        <label class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">
          <input
            type="checkbox"
            name="privacyConsent"
            required
            class="mt-1 h-4 w-4 rounded border-border-color text-eucalyptus-600 focus:ring-eucalyptus-500"
          />
          <span>{content.consentLabel}</span>
        </label>
      </div>

      <div
        data-sample-review-status
        role="status"
        aria-live="polite"
        tabindex="-1"
        class="hidden rounded-2xl border border-amber-500/40 bg-amber-500/10 p-4 text-sm leading-relaxed text-amber-900 focus:outline-none dark:border-amber-400/30 dark:bg-amber-400/10 dark:text-amber-200"
        data-msg-unavailable={content.unavailableMessage}
        data-msg-validation={content.validationMessage}
        data-msg-generic={content.genericErrorMessage}
      >
      </div>

      <div
        data-sample-review-turnstile
        data-sitekey="0x4AAAAAAFuRxbj5vTrO1z1m"
        class="max-w-full overflow-x-auto"
      ></div>

      <div class="space-y-3">
        <Button type="submit" variant="primary" size="lg" class="w-full">
          {content.submitLabel}
        </Button>
        <p class="text-xs leading-relaxed text-text-muted-light dark:text-text-muted-dark">
          {content.footerNote}
        </p>
      </div>
    </form>
    )}
  </div>
</Card>

{isEnabled && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer data-turnstile-script="true"></script>
)}

<script is:inline>
  (() => {
    const isLocal = ['localhost', '127.0.0.1'].includes(window.location.hostname);
    const TURNSTILE_SITE_KEY = isLocal
      ? '1x00000000000000000000AA'
      : '0x4AAAAAAFuRxbj5vTrO1z1m';
    const form = document.querySelector('[data-sample-review-form]');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const submittedAt = form.querySelector('[data-submitted-at="true"]');
    if (submittedAt instanceof HTMLInputElement) {
      submittedAt.value = String(Date.now());
    }

    const status = form.querySelector('[data-sample-review-status]');
    const submitButton = form.querySelector('button[type="submit"]');
    const turnstileContainer = form.querySelector('[data-sample-review-turnstile]');

    const isLocalHost =
      isLocal || window.location.hostname === '[::1]';

    let widgetId = null;
    let turnstileToken = '';
    let turnstileVerifying = false;
    let isSubmitting = false;

    function getTurnstileToken() {
      if (widgetId && window.turnstile && typeof window.turnstile.getResponse === 'function') {
        try {
          const resp = window.turnstile.getResponse(widgetId);
          if (typeof resp === 'string' && resp.length > 0) {
            turnstileToken = resp;
          }
        } catch {
          // Ignore lookup error
        }
      }
      return turnstileToken;
    }

    function isTurnstileReady() {
      return !turnstileVerifying || getTurnstileToken().length > 0 || isLocalHost;
    }

    function syncSubmitButton() {
      if (!(submitButton instanceof HTMLButtonElement)) return;
      submitButton.disabled = isSubmitting || !isTurnstileReady();
    }

    function initTurnstileWidget() {
      if (!(turnstileContainer instanceof HTMLElement)) return;
      if (!window.turnstile || typeof window.turnstile.render !== 'function') return;
      if (widgetId !== null) return;
      try {
        turnstileVerifying = !isLocalHost;
        syncSubmitButton();
        widgetId = window.turnstile.render(turnstileContainer, {
          sitekey: TURNSTILE_SITE_KEY,
          theme: 'auto',
          size: 'flexible',
          appearance: 'interaction-only',
          callback: (token) => {
            turnstileToken = token || '';
            turnstileVerifying = false;
            syncSubmitButton();
          },
          'expired-callback': () => {
            turnstileToken = '';
            turnstileVerifying = !isLocalHost;
            syncSubmitButton();
          },
          'error-callback': () => {
            turnstileToken = '';
            turnstileVerifying = false;
            syncSubmitButton();
            return true;
          },
        });
      } catch {
        turnstileVerifying = false;
        syncSubmitButton();
      }
    }

    if (window.turnstile && typeof window.turnstile.render === 'function') {
      initTurnstileWidget();
    } else {
      const scriptEl = document.querySelector('script[data-turnstile-script="true"]');
      if (scriptEl) {
        scriptEl.addEventListener('load', initTurnstileWidget, { once: true });
      }
    }

    function showStatus(message) {
      if (!(status instanceof HTMLElement)) return;
      status.textContent = message;
      status.classList.remove('hidden');
      status.focus();
    }

    function messageForCode(code) {
      if (!(status instanceof HTMLElement)) return '';
      if (code === 'FEATURE_NOT_CONFIGURED' || code === 'FEATURE_DISABLED' || code === 'CONFIGURATION_INVALID') {
        return status.dataset.msgUnavailable || '';
      }
      if (code === 'VALIDATION_FAILED') return status.dataset.msgValidation || '';
      if (code === 'CHALLENGE_FAILED' || code === 'FORBIDDEN') {
        return status.dataset.msgChallenge || status.dataset.msgGeneric || '';
      }
      return status.dataset.msgGeneric || '';
    }

    form.addEventListener('submit', async (event) => {
      if (submittedAt instanceof HTMLInputElement && !submittedAt.value) {
        submittedAt.value = String(Date.now());
      }

      // Progressive enhancement: intercept when fetch is available, otherwise fall back
      // to the native full-page form POST (still handled correctly server-side).
      if (typeof window.fetch !== 'function') return;

      event.preventDefault();
      if (!isTurnstileReady()) return;

      if (status instanceof HTMLElement) {
        status.classList.add('hidden');
        status.textContent = '';
      }
      isSubmitting = true;
      syncSubmitButton();
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.setAttribute('aria-busy', 'true');
      }

      try {
        const formData = new FormData(form);
        const token = getTurnstileToken();
        formData.set('turnstileToken', token);

        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });

        let payload = null;
        try {
          payload = await response.json();
        } catch {
          payload = null;
        }

        if (response.ok && payload && payload.ok && payload.data && payload.data.redirectTo) {
          window.location.href = payload.data.redirectTo;
          return;
        }

        const code = payload && payload.error && payload.error.code;
        showStatus(messageForCode(code));
      } catch {
        showStatus(messageForCode(null));
      } finally {
        isSubmitting = false;
        turnstileToken = '';
        if (widgetId !== null && window.turnstile && typeof window.turnstile.reset === 'function') {
          try {
            turnstileVerifying = !isLocalHost;
            window.turnstile.reset(widgetId);
          } catch {
            turnstileVerifying = false;
          }
        }
        syncSubmitButton();
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.removeAttribute('aria-busy');
        }
      }
    });
  })();
</script>
