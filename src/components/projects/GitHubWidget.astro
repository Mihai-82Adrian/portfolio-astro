---
/**
 * GitHubWidget Component
 *
 * Renders a static, build-time GitHub summary from src/data/github-snapshot.json.
 * The browser never contacts api.github.com — the snapshot is refreshed
 * explicitly via `node scripts/update-github-snapshot.mjs`, never during
 * build/test. See docs/operations/privacy-consent-external-services.md.
 */
import Icon from '@components/ui/Icon.astro';
import snapshot from '@/data/github-snapshot.json';

const LANGUAGE_COLORS: Record<string, string> = {
  Rust: '#dea584',
  Julia: '#a270ba',
  TypeScript: '#3178c6',
  JavaScript: '#f1e05a',
  Python: '#3572A5',
  HTML: '#e34c26',
  CSS: '#563d7c',
  Shell: '#89e051',
  Dockerfile: '#384d54',
  Vue: '#41b883',
  C: '#555555',
  'C++': '#f34b7d',
  Java: '#b07219',
  Go: '#00ADD8',
  PHP: '#4F5D95',
  Astro: '#ff5a03',
  Ruby: '#701516',
};
const FALLBACK_LANGUAGE_COLOR = '#8b949e';

const snapshotDate = new Date(snapshot.generatedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<div class="github-widget">
  <div class="widget-header">
    <div class="header-icon" aria-hidden="true">
      <Icon name="code" class="h-7 w-7" />
    </div>
    <h3 class="header-title">GitHub Activity</h3>
    <a
      href="https://github.com/Mihai-82Adrian"
      class="header-link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Visit GitHub profile (opens in new tab)"
    >
      View Profile →
    </a>
  </div>

  <!--
    Only the public repository count is shown: this widget performs an
    unauthenticated GitHub API read, which structurally cannot see private
    repositories for any account, so a "total" or "private" figure would be a
    guaranteed-constant artifact presented as if it were measured data.
  -->
  <div class="stats-grid">
    <div class="stat-item">
      <div class="stat-value">{snapshot.publicRepositoryCount}</div>
      <div class="stat-label">Public Repositories</div>
    </div>
  </div>

  <!-- Language Distribution -->
  {snapshot.languages.length > 0 && (
    <div class="languages-section">
      <h4 class="section-title">Top Languages</h4>
      <div class="language-bars">
        {snapshot.languages.map((lang) => (
          <div class="language-item">
            <div class="language-header">
              <span class="language-name">{lang.name}</span>
              <span class="language-percentage">{lang.percentage}%</span>
            </div>
            <div class="language-bar">
              <div
                class="language-fill"
                style={`width: ${lang.percentage}%; background: ${LANGUAGE_COLORS[lang.name] ?? FALLBACK_LANGUAGE_COLOR};`}
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <p class="snapshot-note">Static snapshot from {snapshotDate} — updated periodically, not on every visit.</p>
</div>

<style>
@reference "../../styles/global.css";
  .github-widget {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    padding: 2rem;
    margin: 3rem 0;
  }

  /* Header */
  .widget-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .header-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .header-title {
    @apply font-sans;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .header-link {
    font-size: 0.9375rem;
    font-weight: 600;
    @apply text-eucalyptus-700 dark:text-eucalyptus-300;
    @apply hover:text-eucalyptus-800 dark:hover:text-eucalyptus-200;
    text-decoration: none;
    transition: all 0.2s ease;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .header-link:hover {
    transform: translateX(4px);
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 16rem;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .stat-item {
    text-align: center;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    transition: all 0.3s ease;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .stat-item:hover {
    background: rgba(255, 255, 255, 0.08);
    @apply border-eucalyptus-600 dark:border-eucalyptus-400;
    transform: translateY(-2px);
  }

  .stat-value {
    @apply font-sans;
    font-size: 2rem;
    font-weight: 700;
    @apply text-eucalyptus-700 dark:text-eucalyptus-300;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  /* Section Titles */
  .section-title {
    @apply font-sans;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 1rem;
  }

  /* Languages */
  .languages-section {
    margin-bottom: 1rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 0.75rem;
  }

  .language-bars {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .language-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .language-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .language-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .language-percentage {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .language-bar {
    height: 8px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
  }

  .language-fill {
    height: 100%;
    border-radius: 4px;
  }

  .snapshot-note {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .github-widget {
      padding: 1.5rem;
    }

    .stats-grid {
      max-width: 100%;
      gap: 1rem;
    }

    .header-title {
      font-size: 1.25rem;
    }

    .stat-value {
      font-size: 1.75rem;
    }
  }
</style>
