---
import type { MediaItem, MediaLang } from '../../data/media';
import MediaEmbed from './MediaEmbed.astro';

interface Props {
  item: MediaItem;
  lang?: MediaLang;
}

const { item, lang = 'en' } = Astro.props;

const displayTitle = item.localeLabels?.[lang] ?? item.title;
const displayDescription = item.localeDescriptions?.[lang] ?? item.description;
const typeLabelMap = {
  de: {
    youtube_playlist: 'YouTube-Playlist',
    youtube_video: 'YouTube-Video',
    spotify_artist: 'Spotify-Künstler',
    spotify_playlist: 'Spotify-Playlist',
    spotify_track: 'Spotify-Track',
  },
  en: {
    youtube_playlist: 'YouTube Playlist',
    youtube_video: 'YouTube Video',
    spotify_artist: 'Spotify Artist',
    spotify_playlist: 'Spotify Playlist',
    spotify_track: 'Spotify Track',
  },
  ro: {
    youtube_playlist: 'Playlist YouTube',
    youtube_video: 'Video YouTube',
    spotify_artist: 'Artist Spotify',
    spotify_playlist: 'Playlist Spotify',
    spotify_track: 'Track Spotify',
  },
} as const;
const copy = {
  de: {
    featured: 'Empfohlen',
    openSource: 'Original öffnen',
    openSourceAria: 'Original für',
  },
  en: {
    featured: 'Featured',
    openSource: 'Open source link',
    openSourceAria: 'Open source for',
  },
  ro: {
    featured: 'Recomandat',
    openSource: 'Deschide sursa',
    openSourceAria: 'Deschide sursa pentru',
  },
} as const;
const typeLabel = typeLabelMap[lang][item.type];
const t = copy[lang];
const isPromoShorts = item.tags.includes('promo-shorts');
const layout = isPromoShorts ? 'portrait' : 'landscape';
const platformType = item.type.startsWith('youtube')
  ? 'youtube'
  : item.type.startsWith('spotify')
    ? 'spotify'
    : 'other';
const slot = isPromoShorts
  ? 'promo-shorts'
  : item.type.startsWith('spotify') && item.featured
    ? 'spotify-featured'
    : item.type === 'youtube_playlist' && item.tags.includes('deep-work')
      ? 'youtube-deep-work'
      : 'default';
---

<article
  class="media-card space-y-3"
  data-media-card
  data-featured={item.featured ? 'true' : 'false'}
  data-platform={item.type.startsWith('spotify') ? 'spotify' : 'youtube'}
  data-tags={item.tags.join(',')}
  data-layout={layout}
  data-slot={slot}
>
  <MediaEmbed
    embedUrl={item.embedUrl}
    title={displayTitle}
    orientation={layout}
    type={platformType}
    poster={item.poster}
  />
  <header class="space-y-1">
    <div class="flex items-center gap-2 text-xs">
      <span class="rounded-full bg-eucalyptus-100 px-2 py-1 font-medium text-eucalyptus-800 dark:bg-eucalyptus-900 dark:text-eucalyptus-200">{typeLabel}</span>
      {item.featured && <span class="rounded-full bg-info/15 px-2 py-1 font-medium text-info">{t.featured}</span>}
    </div>
    <h3 class="text-base font-semibold text-text-primary-light dark:text-text-primary-dark text-balance">{displayTitle}</h3>
    {displayDescription && (
      <p class="text-sm text-text-secondary-light dark:text-text-secondary-dark text-pretty">{displayDescription}</p>
    )}
    <a href={item.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-medium text-eucalyptus-700 underline-offset-2 hover:underline dark:text-eucalyptus-300" aria-label={`${t.openSourceAria} ${displayTitle}`}>
      {t.openSource}
    </a>
  </header>
</article>
