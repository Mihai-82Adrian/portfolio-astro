
---
/**
 * ChatWidget Component — V2
 *
 * Tabbed AI Chat interface with:
 * - 💬 Chat tab (intent router + quick action chips)
 * - 📄 JD Analysis tab (structured fit analysis)
 * - 🌐 Language selector (Auto | DE | EN | RO)
 *
 * @component
 */
interface Props {
  class?: string;
  id?: string;
  title?: string;
  subtitle?: string;
  lang?: 'de' | 'en' | 'ro';
}

const props = Astro.props;
const className = props.class || '';
const id = props.id || 'ai-chat-widget';
const lang = props.lang || 'de';
const privacyPolicyUrl = lang === 'de' ? '/datenschutz' : `/${lang}/datenschutz`;
const copy = {
  de: {
    title: 'Ask Mihai · KI',
    subtitle: 'Bereitgestellt mit GPT-5.6',
    responseLanguage: 'Antwortsprache',
    chatTab: '💬 Chat',
    jdTab: '📄 JD-Analyse',
    welcome: "Hi! Ich bin Mihai's KI-Assistent. Ich beantworte Fragen zu Fähigkeiten, Erfahrung, Zertifikaten und Projekten.",
    warning: '⚠️ Antworten werden generiert und können Fehler enthalten.',
    aiDisclosure: 'Deine Nachrichten werden bei Absenden zur Verarbeitung an OpenAI (USA) übermittelt.',
    aiConsentLabel: 'Ich stimme zu, dass meine Eingabe und die KI-generierte Antwort an OpenAI übermittelt werden. Für dieses Projekt ist die freiwillige Weitergabe von API-Eingaben und -Ausgaben an OpenAI aktiviert. OpenAI kann diese Daten zur Qualitätsbewertung sowie zur Verbesserung und zum Training seiner Modelle verwenden. Bitte geben Sie keine sensiblen, vertraulichen oder personenbezogenen Daten über sich oder Dritte ein. Verwenden Sie nach Möglichkeit anonymisierte oder synthetische Angaben. Die KI-Funktion ist optional.',
    aiConsentRequired: 'Bitte bestätige zuerst die Zustimmung zur externen Verarbeitung oben.',
    aiConsentActive: '✓ KI-Einwilligung aktiv',
    aiConsentWithdraw: 'Widerrufen',
    jdConsentWarning: 'Verwenden Sie keine echten Steuer-, Konto-, Gehalts-, Kunden- oder vertraulichen Unternehmensdaten.',
    chips: ['📋 Kontakt', '💼 Aktuelle Rolle', '🎓 Zertifikate', '🚀 Projekte'],
    askPlaceholder: 'Eine Frage stellen...',
    chatMessage: 'Chat-Nachricht',
    sendMessage: 'Nachricht senden',
    chatQuota: '💬 4/4 Fragen',
    jdQuota: '📄 1/1 JD-Analyse',
    hero: '📊 Professionelle Fit-Analyse',
    heroBody: 'Füge eine Stellenbeschreibung ein, um eine detaillierte Passungsanalyse mit Scores und Empfehlungen zu erhalten.',
    tips: '📋 Tipps für beste Ergebnisse',
    tipsLead: 'Für die präziseste Analyse sollte enthalten sein:',
    tipsItems: ['Jobtitel und Firmenname', 'Erforderliche Qualifikationen und Erfahrung', 'Wichtige Verantwortlichkeiten', 'Nice-to-haves und Bonus-Skills', 'Standort und Arbeitsmodell (remote / hybrid / vor Ort)'],
    jdPlaceholder: 'Vollständige Stellenbeschreibung hier einfügen...',
    jdInput: 'Eingabe Stellenbeschreibung',
    analyze: 'Fit analysieren',
  },
  en: {
    title: 'Ask Mihai · AI',
    subtitle: 'Powered by GPT-5.6',
    responseLanguage: 'Response language',
    chatTab: '💬 Chat',
    jdTab: '📄 JD Analysis',
    welcome: "Hi! I'm Mihai's AI assistant. I can answer questions about his skills, experience, certifications, and projects.",
    warning: '⚠️ Answers may be generated and could contain errors.',
    aiDisclosure: 'Your messages are sent to OpenAI (USA) for processing when you submit them.',
    aiConsentLabel: 'I consent to my input and the AI-generated response being sent to OpenAI. This project has enabled voluntary sharing of API inputs and outputs with OpenAI. OpenAI may use this data for quality evaluation and to improve or train its models. Do not enter sensitive, confidential, or third-party personal data. Use anonymized or synthetic information whenever possible. AI is optional.',
    aiConsentRequired: 'Please confirm the consent to external processing above first.',
    aiConsentActive: '✓ AI consent active',
    aiConsentWithdraw: 'Withdraw',
    jdConsentWarning: 'Do not use real tax, account, salary, customer, or confidential business data.',
    chips: ['📋 Contact', '💼 Current Role', '🎓 Certifications', '🚀 Projects'],
    askPlaceholder: 'Ask a question...',
    chatMessage: 'Chat message',
    sendMessage: 'Send message',
    chatQuota: '💬 4/4 questions',
    jdQuota: '📄 1/1 JD analysis',
    hero: '📊 Professional Fit Analysis',
    heroBody: 'Paste a job description to receive a detailed match analysis with scores and recommendations.',
    tips: '📋 Tips for best results',
    tipsLead: 'For the most accurate analysis, include:',
    tipsItems: ['Job Title & Company name', 'Required Qualifications & Experience', 'Key Responsibilities', 'Nice-to-haves & Bonus skills', 'Location & Work model (remote/hybrid/onsite)'],
    jdPlaceholder: 'Paste the full job description here...',
    jdInput: 'Job description input',
    analyze: 'Analyze Fit',
  },
  ro: {
    title: 'Ask Mihai · AI',
    subtitle: 'Cu GPT-5.6',
    responseLanguage: 'Limba răspunsului',
    chatTab: '💬 Chat',
    jdTab: '📄 Analiză JD',
    welcome: 'Salut! Sunt asistentul AI al lui Mihai. Pot răspunde la întrebări despre competențe, experiență, certificări și proiecte.',
    warning: '⚠️ Răspunsurile sunt generate și pot conține erori.',
    aiDisclosure: 'Mesajele tale sunt trimise către OpenAI (SUA) pentru procesare atunci când le trimiți.',
    aiConsentLabel: 'Sunt de acord ca textul introdus de mine și răspunsul generat de AI să fie transmise către OpenAI. Pentru acest proiect este activată partajarea voluntară cu OpenAI a datelor de intrare și ieșire din API. OpenAI poate utiliza aceste date pentru evaluarea calității și pentru îmbunătățirea sau antrenarea modelelor sale. Nu introduceți date sensibile sau confidențiale și nici date cu caracter personal despre dumneavoastră sau despre terți. Folosiți, pe cât posibil, informații anonimizate sau sintetice. Funcția AI este opțională.',
    aiConsentRequired: 'Te rugăm să confirmi mai întâi consimțământul pentru procesarea externă de mai sus.',
    aiConsentActive: '✓ Consimțământ AI activ',
    aiConsentWithdraw: 'Retrage',
    jdConsentWarning: 'Nu introduceți date fiscale, de cont, salariale, ale clienților sau confidențiale ale companiei, reale.',
    chips: ['📋 Contact', '💼 Rol curent', '🎓 Certificări', '🚀 Proiecte'],
    askPlaceholder: 'Pune o întrebare...',
    chatMessage: 'Mesaj chat',
    sendMessage: 'Trimite mesajul',
    chatQuota: '💬 4/4 întrebări',
    jdQuota: '📄 1/1 analiză JD',
    hero: '📊 Analiză profesională de potrivire',
    heroBody: 'Lipește o descriere de job pentru a primi o analiză detaliată de potrivire, cu scoruri și recomandări.',
    tips: '📋 Sfaturi pentru cele mai bune rezultate',
    tipsLead: 'Pentru o analiză cât mai precisă, include:',
    tipsItems: ['Titlul jobului și numele companiei', 'Calificări și experiență necesare', 'Responsabilități cheie', 'Cerințe opționale și bonusuri', 'Locația și modelul de lucru (remote / hybrid / on-site)'],
    jdPlaceholder: 'Lipește aici descrierea completă a jobului...',
    jdInput: 'Introducere descriere job',
    analyze: 'Analizează potrivirea',
  },
}[lang];
const title = props.title || copy.title;
---

<div id={id} class:list={["chat-widget flex flex-col bg-white dark:bg-dark-surface border-gray-200 dark:border-dark-border overflow-hidden w-full h-full", className]} data-chat-widget>
  <!-- Header -->
  <div class="bg-eucalyptus-600 p-4 text-white flex justify-between items-center shrink-0">
    <div class="flex items-center gap-2">
      <span class="text-lg" aria-hidden="true">🤖</span>
      <div>
        <h3 class="font-bold text-lg leading-tight">{title}</h3>
        <p class="text-xs text-eucalyptus-100">{props.subtitle || copy.subtitle}</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <!-- Language Selector -->
        <select
        id={`${id}-lang`}
        name="responseLanguage"
        class="chat-lang-select bg-eucalyptus-700 text-white text-xs rounded-lg px-2 py-1 border border-eucalyptus-500 focus:ring-2 focus:ring-white cursor-pointer"
        aria-label={copy.responseLanguage}
      >
        <option value="auto">🌐 Auto</option>
        <option value="de">🇩🇪 DE</option>
        <option value="en">🇬🇧 EN</option>
        <option value="ro">🇷🇴 RO</option>
      </select>
      <slot name="header-actions" />
    </div>
  </div>

  <!-- Tab Bar -->
  <div class="chat-tab-bar flex border-b border-gray-200 dark:border-dark-border bg-white dark:bg-dark-surface shrink-0" role="tablist">
    <button
      class="chat-tab flex-1 px-4 py-2.5 text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:ring-eucalyptus-500"
      role="tab"
      aria-selected="true"
      aria-controls="chat-panel-chat"
      data-tab="chat"
    >
      {copy.chatTab}
    </button>
    <button
      class="chat-tab flex-1 px-4 py-2.5 text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:ring-eucalyptus-500"
      role="tab"
      aria-selected="false"
      aria-controls="chat-panel-jd"
      data-tab="jd"
    >
      {copy.jdTab}
    </button>
  </div>

  <!-- ═══ Chat Tab Panel ═══ -->
  <div id="chat-panel-chat" class="chat-panel flex flex-col flex-1 overflow-hidden" role="tabpanel" data-panel="chat">
    <!-- Messages Area -->
    <div class="chat-messages flex-1 overflow-y-auto p-4 space-y-3 bg-gray-50 dark:bg-dark-bg" aria-live="polite" aria-atomic="false">
      <!-- Welcome Message -->
      <div class="message ai bg-white dark:bg-dark-elevated p-3 rounded-lg rounded-tl-none shadow-subtle text-sm dark:text-gray-200 border border-gray-100 dark:border-dark-border max-w-88">
        <p>{copy.welcome}</p>
        <span class="text-xs text-text-secondary-light dark:text-text-secondary-dark mt-2 block">{copy.warning}</span>
        <span class="text-xs text-text-secondary-light dark:text-text-secondary-dark mt-1 block">
          {copy.aiDisclosure}{' '}
          <a href={privacyPolicyUrl} class="underline hover:text-eucalyptus-700 dark:hover:text-eucalyptus-300">
            {lang === 'de' ? 'Datenschutz' : lang === 'en' ? 'Privacy policy' : 'Confidențialitate'}
          </a>
        </span>
      </div>

      <!-- Quick Action Chips -->
      <div class="quick-chips flex flex-wrap gap-2 mt-1">
        <button class="chip-btn" data-chip="contact" type="button">{copy.chips[0]}</button>
        <button class="chip-btn" data-chip="current_role" type="button">{copy.chips[1]}</button>
        <button class="chip-btn" data-chip="certifications" type="button">{copy.chips[2]}</button>
        <button class="chip-btn" data-chip="projects" type="button">{copy.chips[3]}</button>
      </div>
    </div>

    <!-- AI contextual consent (chat tab) -->
    <div class="chat-consent shrink-0" data-consent-state="undecided">
      <div class="chat-consent-expanded px-3 pt-2 bg-white dark:bg-dark-surface border-t border-gray-200 dark:border-dark-border">
        <label class="flex items-start gap-2 text-xs text-text-secondary-light dark:text-text-secondary-dark cursor-pointer">
          <input
            type="checkbox"
            class="chat-consent-checkbox mt-0.5 h-4 w-4 shrink-0 rounded border-gray-300 dark:border-gray-600 text-eucalyptus-600 focus-visible:ring-2 focus-visible:ring-eucalyptus-500"
            aria-describedby={`${id}-chat-consent-error`}
          />
          <span>{copy.aiConsentLabel}</span>
        </label>
        <p id={`${id}-chat-consent-error`} class="chat-consent-error hidden mt-1 text-xs text-error" role="alert">{copy.aiConsentRequired}</p>
      </div>
      <div class="chat-consent-status hidden flex items-center justify-between gap-2 px-3 min-h-11 bg-white dark:bg-dark-surface border-t border-gray-200 dark:border-dark-border text-xs text-text-secondary-light dark:text-text-secondary-dark">
        <span class="py-2">{copy.aiConsentActive}</span>
        <button type="button" class="chat-consent-withdraw min-h-11 min-w-11 px-2 -mr-2 font-medium text-eucalyptus-700 dark:text-eucalyptus-300 hover:underline focus-visible:ring-2 focus-visible:ring-eucalyptus-500 rounded">{copy.aiConsentWithdraw}</button>
      </div>
    </div>

    <!-- Chat Input -->
    <form class="chat-form p-3 bg-white dark:bg-dark-surface border-t border-gray-200 dark:border-dark-border flex gap-2 items-end shrink-0">
      <textarea
        id={`${id}-message`}
        name="message"
        placeholder={copy.askPlaceholder}
        aria-label={copy.chatMessage}
        rows="1"
        maxlength="4000"
        class="chat-input flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-2xl focus:ring-2 focus:ring-eucalyptus-500 dark:bg-dark-elevated dark:text-white text-sm resize-none overflow-hidden max-h-32"
        required
      ></textarea>
      <button
        type="submit"
        aria-label={copy.sendMessage}
        class="chat-send-btn bg-eucalyptus-600 hover:bg-eucalyptus-700 text-white p-2 rounded-full transition-colors disabled:opacity-50 disabled:cursor-not-allowed shrink-0"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 rotate-90" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
        </svg>
      </button>
    </form>
    <!-- Quota Badge -->
    <div class="quota-badge px-3 py-1.5 text-xs text-text-tertiary-light dark:text-text-tertiary-dark flex items-center gap-3 border-t border-gray-100 dark:border-dark-border bg-white dark:bg-dark-surface shrink-0">
      <span class="quota-chat-text">{copy.chatQuota}</span>
      <span class="text-gray-300 dark:text-gray-600">|</span>
      <span class="quota-jd-text">{copy.jdQuota}</span>
    </div>
  </div>

  <!-- ═══ JD Analysis Tab Panel ═══ -->
  <div id="chat-panel-jd" class="chat-panel flex flex-col flex-1 overflow-hidden hidden" role="tabpanel" data-panel="jd">
    <!-- JD Content -->
    <div class="flex-1 overflow-y-auto p-4 bg-gray-50 dark:bg-dark-bg">
      <!-- JD Hero -->
      <div class="text-center mb-4">
        <div class="inline-flex items-center gap-2 bg-eucalyptus-50 dark:bg-eucalyptus-950 text-eucalyptus-700 dark:text-eucalyptus-300 px-3 py-1.5 rounded-full text-xs font-medium mb-2">
          <span aria-hidden="true">📊</span> {copy.hero}
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-400">{copy.heroBody}</p>
      </div>

      <!-- Structure Guide (collapsible) -->
      <details class="jd-guide mb-3 bg-white dark:bg-dark-elevated rounded-lg border border-gray-200 dark:border-dark-border">
        <summary class="px-3 py-2 text-xs font-medium text-gray-600 dark:text-gray-400 cursor-pointer hover:text-eucalyptus-600 transition-colors select-none">
          {copy.tips}
        </summary>
        <div class="px-3 pb-3 text-xs text-gray-500 dark:text-gray-400 space-y-1">
          <p>{copy.tipsLead}</p>
          <ul class="list-disc pl-4 space-y-0.5">
            {copy.tipsItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </details>

      <!-- JD Textarea -->
      <textarea
        id={`${id}-jd-input`}
        name="jobDescription"
        class="jd-input w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-eucalyptus-500 dark:bg-dark-elevated dark:text-white text-sm resize-none"
        placeholder={copy.jdPlaceholder}
        rows="10"
        maxlength="6000"
        aria-label={copy.jdInput}
      ></textarea>

      <!-- AI contextual consent (JD tab) -->
      <div class="jd-consent mt-2" data-consent-state="undecided">
        <div class="jd-consent-expanded">
          <p class="mb-1 text-xs font-medium text-text-secondary-light dark:text-text-secondary-dark">{copy.jdConsentWarning}</p>
          <label class="flex items-start gap-2 text-xs text-text-secondary-light dark:text-text-secondary-dark cursor-pointer">
            <input
              type="checkbox"
              class="jd-consent-checkbox mt-0.5 h-4 w-4 shrink-0 rounded border-gray-300 dark:border-gray-600 text-eucalyptus-600 focus-visible:ring-2 focus-visible:ring-eucalyptus-500"
              aria-describedby={`${id}-jd-consent-error`}
            />
            <span>{copy.aiConsentLabel}</span>
          </label>
          <p id={`${id}-jd-consent-error`} class="jd-consent-error hidden mt-1 text-xs text-error" role="alert">{copy.aiConsentRequired}</p>
        </div>
        <div class="jd-consent-status hidden flex items-center justify-between gap-2 min-h-11 text-xs text-text-secondary-light dark:text-text-secondary-dark">
          <span class="py-2">{copy.aiConsentActive}</span>
          <button type="button" class="jd-consent-withdraw min-h-11 min-w-11 px-2 -mr-2 font-medium text-eucalyptus-700 dark:text-eucalyptus-300 hover:underline focus-visible:ring-2 focus-visible:ring-eucalyptus-500 rounded">{copy.aiConsentWithdraw}</button>
        </div>
      </div>

      <!-- Character Counter -->
      <div class="flex justify-between items-center mt-2">
        <span class="jd-char-count text-xs text-gray-400">0 / 6,000</span>
        <button
          type="button"
          class="jd-analyze-btn bg-eucalyptus-600 hover:bg-eucalyptus-700 text-white px-4 py-2 rounded-xl text-sm font-medium transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 shadow-subtle hover:shadow-elevated"
          disabled
        >
          <span aria-hidden="true">🔍</span> {copy.analyze}
        </button>
      </div>

      <!-- JD Results Container -->
      <div class="jd-results mt-4 hidden"></div>
    </div>
  </div>
</div>

<script>
  import { AI_PRIVACY_NOTICE_VERSION } from '../../functions/_lib/ai-privacy-notice.ts';

  class ChatWidget {
    container: HTMLElement;
    // Chat tab elements
    form: HTMLFormElement;
    input: HTMLTextAreaElement;
    messagesEl: HTMLElement;
    submitBtn: HTMLButtonElement | null;
    chipsContainer: HTMLElement | null;
    chatConsentContainer: HTMLElement | null;
    chatConsentExpanded: HTMLElement | null;
    chatConsentStatus: HTMLElement | null;
    chatConsentWithdrawBtn: HTMLButtonElement | null;
    chatConsentCheckbox: HTMLInputElement | null;
    chatConsentError: HTMLElement | null;
    // JD tab elements
    jdInput: HTMLTextAreaElement | null;
    jdAnalyzeBtn: HTMLButtonElement | null;
    jdCharCount: HTMLElement | null;
    jdResults: HTMLElement | null;
    jdConsentContainer: HTMLElement | null;
    jdConsentExpanded: HTMLElement | null;
    jdConsentStatus: HTMLElement | null;
    jdConsentWithdrawBtn: HTMLButtonElement | null;
    jdConsentCheckbox: HTMLInputElement | null;
    jdConsentError: HTMLElement | null;
    // Tab & language
    tabs: NodeListOf<HTMLButtonElement>;
    panels: NodeListOf<HTMLElement>;
    langSelect: HTMLSelectElement | null;
    // Quota elements
    quotaBadge: HTMLElement | null;
    quotaChatText: HTMLElement | null;
    quotaJdText: HTMLElement | null;
    activeTab: string = 'chat';

    constructor(el: HTMLElement) {
      this.container = el;
      this.form = el.querySelector('.chat-form') as HTMLFormElement;
      this.input = el.querySelector('.chat-input') as HTMLTextAreaElement;
      this.messagesEl = el.querySelector('.chat-messages') as HTMLElement;
      this.submitBtn = this.form.querySelector('.chat-send-btn');
      this.chipsContainer = el.querySelector('.quick-chips');
      this.chatConsentContainer = el.querySelector('.chat-consent');
      this.chatConsentExpanded = el.querySelector('.chat-consent-expanded');
      this.chatConsentStatus = el.querySelector('.chat-consent-status');
      this.chatConsentWithdrawBtn = el.querySelector('.chat-consent-withdraw');
      this.chatConsentCheckbox = el.querySelector('.chat-consent-checkbox');
      this.chatConsentError = el.querySelector('.chat-consent-error');

      this.jdInput = el.querySelector('.jd-input');
      this.jdAnalyzeBtn = el.querySelector('.jd-analyze-btn');
      this.jdCharCount = el.querySelector('.jd-char-count');
      this.jdResults = el.querySelector('.jd-results');
      this.jdConsentContainer = el.querySelector('.jd-consent');
      this.jdConsentExpanded = el.querySelector('.jd-consent-expanded');
      this.jdConsentStatus = el.querySelector('.jd-consent-status');
      this.jdConsentWithdrawBtn = el.querySelector('.jd-consent-withdraw');
      this.jdConsentCheckbox = el.querySelector('.jd-consent-checkbox');
      this.jdConsentError = el.querySelector('.jd-consent-error');

      this.tabs = el.querySelectorAll('.chat-tab');
      this.panels = el.querySelectorAll('.chat-panel');
      this.langSelect = el.querySelector('.chat-lang-select');

      this.quotaBadge = el.querySelector('.quota-badge');
      this.quotaChatText = el.querySelector('.quota-chat-text');
      this.quotaJdText = el.querySelector('.quota-jd-text');

      this.init();
    }

    init() {
      // Tab switching
      this.tabs.forEach(tab => {
        tab.addEventListener('click', () => this.switchTab(tab.dataset.tab || 'chat'));
      });

      // Chat form
      this.form.addEventListener('submit', (e) => this.handleChatSubmit(e));

      // Auto-resize textarea
      this.input.addEventListener('input', () => {
        this.input.style.height = 'auto';
        this.input.style.height = Math.min(this.input.scrollHeight, 128) + 'px';
      });

      // Enter to send, Shift+Enter for newline
      this.input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          this.form.requestSubmit();
        }
      });

      // Quick action chips
      this.chipsContainer?.querySelectorAll('.chip-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const chip = (btn as HTMLElement).dataset.chip || '';
          this.handleChipClick(chip);
        });
      });

      // JD Analysis
      if (this.jdInput) {
        this.jdInput.addEventListener('input', () => this.updateJdCharCount());
      }
      if (this.jdAnalyzeBtn) {
        this.jdAnalyzeBtn.addEventListener('click', () => this.handleJdAnalyze());
      }

      // AI contextual consent — checking either box immediately grants and collapses that
      // surface's own disclosure (owner amendment, Phase 5-D1A); each tab's checkbox/withdrawal
      // is wired independently, so granting or withdrawing one never touches the other.
      this.chatConsentCheckbox?.addEventListener('change', () => this.handleConsentChecked('chat'));
      this.jdConsentCheckbox?.addEventListener('change', () => this.handleConsentChecked('jd'));
      this.chatConsentWithdrawBtn?.addEventListener('click', () => this.handleConsentWithdraw('chat'));
      this.jdConsentWithdrawBtn?.addEventListener('click', () => this.handleConsentWithdraw('jd'));
    }

    // ─── Helpers ─────────────────────────────────────────────────

    clearElement(el: HTMLElement) {
      while (el.firstChild) {
        el.removeChild(el.firstChild);
      }
    }

    getApiHeaders(): Record<string, string> {
      return {
        'Content-Type': 'application/json',
      };
    }

    // Gate for the two AI-invoking actions (free-text chat, JD analysis). Deterministic fact
    // chips never call OpenAI, so they are intentionally not gated here.
    requireConsent(checkbox: HTMLInputElement | null, errorEl: HTMLElement | null): boolean {
      if (checkbox?.checked) {
        errorEl?.classList.add('hidden');
        checkbox?.setAttribute('aria-invalid', 'false');
        return true;
      }
      errorEl?.classList.remove('hidden');
      checkbox?.setAttribute('aria-invalid', 'true');
      checkbox?.focus();
      return false;
    }

    // ─── AI contextual consent lifecycle (undecided -> granted -> withdrawn) ───
    // Each surface (chat/jd) owns its own transient state; granting or withdrawing one never
    // touches the other (privacy-consent-external-services.md: consent is scoped per surface).

    setConsentState(surface: 'chat' | 'jd', state: 'undecided' | 'granted' | 'withdrawn') {
      const container = surface === 'chat' ? this.chatConsentContainer : this.jdConsentContainer;
      const expanded = surface === 'chat' ? this.chatConsentExpanded : this.jdConsentExpanded;
      const status = surface === 'chat' ? this.chatConsentStatus : this.jdConsentStatus;
      if (!container) return;
      container.dataset.consentState = state;
      const granted = state === 'granted';
      expanded?.classList.toggle('hidden', granted);
      status?.classList.toggle('hidden', !granted);
    }

    // Checking the box immediately grants and collapses the disclosure — no submit required, no
    // network request triggered. Unchecking it directly (without using Withdraw) only matters
    // while still undecided, where the expanded disclosure is already showing, so no transition
    // is needed.
    handleConsentChecked(surface: 'chat' | 'jd') {
      const checkbox = surface === 'chat' ? this.chatConsentCheckbox : this.jdConsentCheckbox;
      const errorEl = surface === 'chat' ? this.chatConsentError : this.jdConsentError;
      if (!checkbox?.checked) return;
      errorEl?.classList.add('hidden');
      checkbox.setAttribute('aria-invalid', 'false');
      this.setConsentState(surface, 'granted');
    }

    handleConsentWithdraw(surface: 'chat' | 'jd') {
      const checkbox = surface === 'chat' ? this.chatConsentCheckbox : this.jdConsentCheckbox;
      const errorEl = surface === 'chat' ? this.chatConsentError : this.jdConsentError;
      if (checkbox) checkbox.checked = false;
      errorEl?.classList.add('hidden');
      checkbox?.setAttribute('aria-invalid', 'false');
      this.setConsentState(surface, 'withdrawn');
      checkbox?.focus();
    }

    updateQuota(quotaData: { q: number; jd: number; maxQ: number; maxJd: number } | undefined) {
      if (!quotaData || !this.quotaChatText || !this.quotaJdText) return;

      const chatRemaining = quotaData.maxQ - quotaData.q;
      const jdRemaining = quotaData.maxJd - quotaData.jd;

      this.quotaChatText.textContent = `\u{1F4AC} ${chatRemaining}/${quotaData.maxQ} questions`;
      this.quotaJdText.textContent = `\u{1F4C4} ${jdRemaining}/${quotaData.maxJd} JD analysis`;

      // Color coding
      const chatColor = chatRemaining === 0 ? 'text-error' : chatRemaining === 1 ? 'text-warning' : 'text-gray-400 dark:text-gray-500';
      const jdColor = jdRemaining === 0 ? 'text-error' : 'text-gray-400 dark:text-gray-500';

      this.quotaChatText.className = `quota-chat-text ${chatColor}`;
      this.quotaJdText.className = `quota-jd-text ${jdColor}`;

      // Disable inputs if exhausted
      if (chatRemaining === 0 && this.activeTab === 'chat') {
        this.input.disabled = true;
        this.input.placeholder = 'Session limit reached. Come back tomorrow!';
        if (this.submitBtn) this.submitBtn.disabled = true;
      }
      if (jdRemaining === 0 && this.jdAnalyzeBtn) {
        this.jdAnalyzeBtn.disabled = true;
      }
    }

    // ─── Tab Management ─────────────────────────────────────────

    switchTab(tabId: string) {
      this.activeTab = tabId;
      this.tabs.forEach(tab => {
        const isActive = tab.dataset.tab === tabId;
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.classList.toggle('tab-active', isActive);
        tab.classList.toggle('tab-inactive', !isActive);
      });
      this.panels.forEach(panel => {
        const isActive = panel.dataset.panel === tabId;
        panel.classList.toggle('hidden', !isActive);
      });
    }

    // ─── Quick Action Chips ─────────────────────────────────────

    async handleChipClick(chipType: string) {
      const chipLabels: Record<string, string> = {
        contact: '📋 Show contact info',
        current_role: '💼 What is the current role?',
        certifications: '🎓 List certifications',
        projects: '🚀 What are the current projects?',
      };

      const displayText = chipLabels[chipType] || chipType;
      this.appendMessage(displayText, true);

      this.showLoading();

      try {
        const lang = this.langSelect?.value || 'auto';
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: this.getApiHeaders(),
          body: JSON.stringify({ message: displayText, lang, tab: 'chat', intent: chipType })
        });

        this.removeLoading();

        if (!res.ok) {
          throw new Error(await this.parseError(res));
        }

        const contentType = res.headers.get('Content-Type') || '';
        if (contentType.includes('text/event-stream')) {
          await this.consumeStream(res);
        } else {
          // Non-streaming (fact responses)
          const data = await res.json();
          this.appendMessage(data.data.answer, false, data.data.sources);
          this.updateQuota(data.data.quota);
        }

      } catch (err: any) {
        this.removeLoading();
        this.appendMessage(err.message || 'Something went wrong.', false);
      }
    }

    // ─── Chat Submission ────────────────────────────────────────

    async handleChatSubmit(e: Event) {
      e.preventDefault();
      const text = this.input.value.trim();
      if (!text) return;
      if (!this.requireConsent(this.chatConsentCheckbox, this.chatConsentError)) return;

      this.appendMessage(text, true);
      this.input.value = '';
      this.input.style.height = 'auto';
      if (this.submitBtn) this.submitBtn.disabled = true;

      // Hide chips
      if (this.chipsContainer) {
        this.chipsContainer.style.display = 'none';
      }

      this.showLoading();

      try {
        const lang = this.langSelect?.value || 'auto';
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: this.getApiHeaders(),
          body: JSON.stringify({
            message: text,
            lang,
            tab: 'chat',
            privacyConsent: true,
            privacyNoticeVersion: AI_PRIVACY_NOTICE_VERSION,
          })
        });

        this.removeLoading();

        if (!res.ok) {
          throw new Error(await this.parseError(res));
        }

        const contentType = res.headers.get('Content-Type') || '';
        if (contentType.includes('text/event-stream')) {
          await this.consumeStream(res);
        } else {
          // Fallback for non-streaming responses
          const data = await res.json();
          this.appendMessage(data.data.answer, false, data.data.sources);
          this.updateQuota(data.data.quota);
        }

      } catch (err: any) {
        this.removeLoading();
        this.appendMessage(err.message || 'Something went wrong.', false);
      } finally {
        if (this.submitBtn) this.submitBtn.disabled = false;
        this.input.focus();
      }
    }

    // ─── JD Analysis ────────────────────────────────────────────

    updateJdCharCount() {
      if (!this.jdInput || !this.jdCharCount || !this.jdAnalyzeBtn) return;
      const len = this.jdInput.value.length;
      const formatted = len.toLocaleString();
      this.jdCharCount.textContent = `${formatted} / 6,000`;

      // Enable analyze button if there's enough text
      this.jdAnalyzeBtn.disabled = len < 50;

      // Color the counter
      if (len > 5500) {
        this.jdCharCount.className = 'jd-char-count text-xs text-error';
      } else if (len > 4500) {
        this.jdCharCount.className = 'jd-char-count text-xs text-warning';
      } else {
        this.jdCharCount.className = 'jd-char-count text-xs text-gray-400';
      }
    }

    async handleJdAnalyze() {
      if (!this.jdInput || !this.jdAnalyzeBtn || !this.jdResults) return;

      const text = this.jdInput.value.trim();
      if (text.length < 50) return;
      if (!this.requireConsent(this.jdConsentCheckbox, this.jdConsentError)) return;

      this.jdAnalyzeBtn.disabled = true;
      this.jdAnalyzeBtn.textContent = '⏳ Analyzing...';
      this.clearElement(this.jdResults);
      this.jdResults.classList.remove('hidden');

      // Show loading in results area
      const loadingEl = document.createElement('div');
      loadingEl.className = 'flex items-center justify-center py-8';
      const dotsContainer = document.createElement('div');
      dotsContainer.className = 'flex space-x-1';
      ['', 'delay-75', 'delay-150'].forEach(delay => {
        const dot = document.createElement('div');
        dot.className = `w-2 h-2 bg-eucalyptus-400 rounded-full animate-bounce ${delay}`;
        dotsContainer.appendChild(dot);
      });
      loadingEl.appendChild(dotsContainer);
      this.jdResults.appendChild(loadingEl);

      try {
        const lang = this.langSelect?.value || 'auto';
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: this.getApiHeaders(),
          body: JSON.stringify({
            message: text,
            lang,
            tab: 'jd',
            privacyConsent: true,
            privacyNoticeVersion: AI_PRIVACY_NOTICE_VERSION,
          })
        });

        if (!res.ok) {
          throw new Error(await this.parseError(res));
        }

        const data = await res.json();
        this.clearElement(this.jdResults);
        this.renderJdResult(data.data.answer, data.data.sources);
        this.updateQuota(data.data.quota);

      } catch (err: any) {
        this.clearElement(this.jdResults);
        this.renderJdError(err.message || 'Analysis failed. Please try again.');
      } finally {
        this.jdAnalyzeBtn.disabled = false;
        this.clearElement(this.jdAnalyzeBtn);
        const icon = document.createElement('span');
        icon.setAttribute('aria-hidden', 'true');
        icon.textContent = '🔍';
        this.jdAnalyzeBtn.appendChild(icon);
        this.jdAnalyzeBtn.appendChild(document.createTextNode(' Analyze Fit'));
      }
    }

    renderJdResult(answer: string, sources: any[] = []) {
      if (!this.jdResults) return;

      // Try to parse structured JSON
      let parsed: any = null;
      try {
        // Strip markdown fences if present
        const cleaned = answer.replace(/^```(?:json)?\s*/i, '').replace(/\s*```$/i, '').trim();
        parsed = JSON.parse(cleaned);
      } catch {
        // Fallback: render as plain text
        this.renderJdResultFallback(answer, sources);
        return;
      }

      const container = document.createElement('div');
      container.className = 'jd-result-card space-y-4 animate-fade-in';

      // ── Score Header ─────────────────────────────────────────
      const scoreSection = document.createElement('div');
      scoreSection.className = 'bg-white dark:bg-dark-elevated rounded-xl border border-gray-200 dark:border-dark-border shadow-subtle p-4';

      // Verdict + Score row
      const topRow = document.createElement('div');
      topRow.className = 'flex items-center justify-between mb-3';

      const verdictBadge = document.createElement('span');
      const score = parsed.score || 0;
      const verdict = parsed.verdict || 'Unknown';
      const verdictColors: Record<string, string> = {
        'Strong Match': 'bg-eucalyptus-100 dark:bg-eucalyptus-900 text-eucalyptus-800 dark:text-eucalyptus-200 border-eucalyptus-300 dark:border-eucalyptus-700',
        'Good Match': 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 border-blue-300 dark:border-blue-700',
        'Partial Match': 'bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-200 border-amber-300 dark:border-amber-700',
        'Not Aligned': 'bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 border-red-300 dark:border-red-700',
      };
      verdictBadge.className = `px-3 py-1 rounded-full text-xs font-bold border ${verdictColors[verdict] || verdictColors['Partial Match']}`;
      verdictBadge.textContent = verdict;
      topRow.appendChild(verdictBadge);

      const scoreLabel = document.createElement('span');
      scoreLabel.className = 'text-2xl font-bold text-gray-800 dark:text-gray-200';
      scoreLabel.textContent = `${score}%`;
      topRow.appendChild(scoreLabel);
      scoreSection.appendChild(topRow);

      // Progress bar
      const barBg = document.createElement('div');
      barBg.className = 'w-full h-2.5 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden mb-3';
      const barFill = document.createElement('div');
      const barColor = score >= 80 ? 'bg-eucalyptus-500' : score >= 60 ? 'bg-blue-500' : score >= 40 ? 'bg-amber-500' : 'bg-red-500';
      barFill.className = `h-full ${barColor} rounded-full transition-all duration-1000 ease-out`;
      barFill.style.width = '0%';
      barBg.appendChild(barFill);
      scoreSection.appendChild(barBg);
      // Animate bar
      requestAnimationFrame(() => { requestAnimationFrame(() => { barFill.style.width = `${score}%`; }); });

      // Summary
      if (parsed.summary) {
        const summary = document.createElement('p');
        summary.className = 'text-sm text-gray-600 dark:text-gray-400 leading-relaxed';
        summary.textContent = parsed.summary;
        scoreSection.appendChild(summary);
      }
      container.appendChild(scoreSection);

      // ── Match Sections ────────────────────────────────────────
      const sections: Array<{ title: string; icon: string; items: any[]; type: 'match' | 'transfer' | 'gap' }> = [
        { title: 'Matching Qualifications', icon: '\u2705', items: parsed.matches || [], type: 'match' },
        { title: 'Transferable Skills', icon: '\ud83d\udd04', items: parsed.transferable || [], type: 'transfer' },
        { title: 'Gaps / Differences', icon: '\u26a0\ufe0f', items: parsed.gaps || [], type: 'gap' },
      ];

      for (const section of sections) {
        if (section.items.length === 0) continue;

        const sectionEl = document.createElement('div');
        sectionEl.className = 'bg-white dark:bg-dark-elevated rounded-xl border border-gray-200 dark:border-dark-border shadow-subtle';

        const sectionHeader = document.createElement('div');
        sectionHeader.className = 'flex items-center gap-2 px-4 py-2.5 border-b border-gray-100 dark:border-dark-border';
        const icon = document.createElement('span');
        icon.textContent = section.icon;
        sectionHeader.appendChild(icon);
        const title = document.createElement('h5');
        title.className = 'text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider';
        title.textContent = section.title;
        sectionHeader.appendChild(title);
        const count = document.createElement('span');
        count.className = 'ml-auto text-xs bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400 px-1.5 py-0.5 rounded-full';
        count.textContent = String(section.items.length);
        sectionHeader.appendChild(count);
        sectionEl.appendChild(sectionHeader);

        const list = document.createElement('div');
        list.className = 'divide-y divide-gray-50 dark:divide-dark-border';

        for (const item of section.items) {
          const row = document.createElement('div');
          row.className = 'px-4 py-2.5';

          const skillName = document.createElement('div');
          skillName.className = 'text-sm font-semibold text-gray-800 dark:text-gray-200 mb-0.5';
          skillName.textContent = item.skill || item.requirement || '';
          row.appendChild(skillName);

          const detail = document.createElement('div');
          detail.className = 'text-xs text-gray-500 dark:text-gray-400 leading-relaxed';
          detail.textContent = item.detail || '';
          row.appendChild(detail);

          if (item.source && section.type === 'match') {
            const srcLink = document.createElement('a');
            srcLink.href = item.source;
            srcLink.target = '_blank';
            srcLink.rel = 'noopener noreferrer';
            srcLink.className = 'inline-block mt-1 text-xs text-eucalyptus-600 dark:text-eucalyptus-400 hover:underline';
            srcLink.textContent = '\u{1F517} Source';
            row.appendChild(srcLink);
          }
          list.appendChild(row);
        }
        sectionEl.appendChild(list);
        container.appendChild(sectionEl);
      }

      // ── Recommendation ─────────────────────────────────────────
      if (parsed.recommendation) {
        const recSection = document.createElement('div');
        recSection.className = 'bg-eucalyptus-50 dark:bg-eucalyptus-950 rounded-xl border border-eucalyptus-200 dark:border-eucalyptus-800 p-4';
        const recHeader = document.createElement('div');
        recHeader.className = 'flex items-center gap-2 mb-2';
        const recIcon = document.createElement('span');
        recIcon.textContent = '\ud83d\udca1';
        recHeader.appendChild(recIcon);
        const recTitle = document.createElement('h5');
        recTitle.className = 'text-xs font-bold text-eucalyptus-800 dark:text-eucalyptus-200 uppercase tracking-wider';
        recTitle.textContent = 'Recommendation';
        recHeader.appendChild(recTitle);
        recSection.appendChild(recHeader);
        const recText = document.createElement('p');
        recText.className = 'text-sm text-eucalyptus-700 dark:text-eucalyptus-300 leading-relaxed';
        recText.textContent = parsed.recommendation;
        recSection.appendChild(recText);
        container.appendChild(recSection);
      }

      // ── Sources ──────────────────────────────────────────────
      if (sources && sources.length > 0) {
        const srcDiv = document.createElement('div');
        srcDiv.className = 'px-1';
        const srcLabel = document.createElement('p');
        srcLabel.className = 'text-xs text-gray-400 uppercase tracking-wider font-medium mb-1';
        srcLabel.textContent = 'Portfolio Sources';
        srcDiv.appendChild(srcLabel);
        const srcList = document.createElement('div');
        srcList.className = 'flex flex-wrap gap-1';
        sources.forEach(src => {
          const badge = document.createElement('a');
          badge.href = src.url;
