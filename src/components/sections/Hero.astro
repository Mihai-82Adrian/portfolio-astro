---
/**
 * Hero Component
 *
 * Homepage hero section with gradient text, animated intro, and CTA buttons.
 * Features responsive design and eucalyptus green branding.
 *
 * @component
 */

import Button from '@components/ui/Button.astro';
import Container from '@components/ui/Container.astro';
import { translations } from '@data/translations';
import type { Language } from '@utils/i18n';
import { Image } from 'astro:assets';
import heroImage from '@/../public/images/2025-2_50PM.webp';

interface Props {
  /** Active language */
  lang?: Language;
  /** Hero title */
  title?: string;
  /** Hero subtitle/tagline */
  subtitle?: string;
  /** Description text */
  description?: string;
  /** Primary CTA text */
  primaryCta?: string;
  /** Primary CTA href */
  primaryHref?: string;
  /** Secondary CTA text */
  secondaryCta?: string;
  /** Secondary CTA href */
  secondaryHref?: string;
  /** Hero image source */
  imageSrc?: string;
  /** Hero image alt text */
  imageAlt?: string;
  /** Skills section label */
  skillsLabel?: string;
  /** Availability badge text */
  badgeText?: string;
  /** Skills array */
  skills?: string[];
}

const lang = (Astro.props.lang ?? 'de') as Language;
const t = translations[lang];

const {
  title = t.home.title,
  subtitle = t.home.subtitle,
  description = t.home.description,
  primaryCta = t.home.cta.viewProjects,
  primaryHref = lang === 'de' ? '/experience' : `/${lang}/experience`,
  secondaryCta = t.home.cta.readBlog,
  secondaryHref = '/blog',
  imageSrc,
  imageAlt = '',
  badgeText = t.home.availabilityBadge,
  skillsLabel = t.home.skillsLabel,
  skills = t.home.heroSkills,
} = Astro.props;

const heroSkills = skills as string[];
---

<section class="hero-section">
  <Container maxWidth="lg" paddingY="none" class="py-8 sm:py-10 md:py-14 lg:py-16 xl:py-20">
    <div class="hero-shell">
      <!-- Hero Banner Image (Wide) -->
      {imageSrc && (
        <div class="hero-banner-wrapper">
          <Image
            src={heroImage}
            alt={imageAlt}
            width={1200}
            height={400}
            format="avif"
            quality={80}
            class="hero-banner"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}

      <div class="hero-content">
        <!-- Animated Badge -->
        <div class="hero-badge">
          <span class="hero-badge-dot"></span>
          <span class="hero-badge-text">{badgeText}</span>
        </div>

        <!-- Main Title with Accent -->
        <h1 class="hero-title text-balance">
          {title}
        </h1>

        <!-- Accent Line -->
        <div class="hero-accent-line"></div>

        <!-- Subtitle with Gradient -->
        <p class="hero-subtitle text-pretty">
          <span class="text-gradient">{subtitle}</span>
        </p>

        <!-- Description -->
        <p class="hero-description text-pretty">
          {description}
        </p>

        <!-- CTA Buttons -->
        <div class="hero-cta-group">
          <slot>
            <Button
              variant="primary"
              size="lg"
              href={primaryHref}
            >
              {primaryCta}
              <svg
                class="ml-2 -mr-1 w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"
                />
              </svg>
            </Button>

            <Button
              variant="secondary"
              size="lg"
              href={secondaryHref}
            >
              {secondaryCta}
            </Button>
          </slot>
        </div>

        <!-- Tech Stack Icons (Optional) -->
        <div class="hero-tech-stack">
          <p class="hero-tech-label">{skillsLabel}</p>
          <div class="hero-tech-icons">
            {heroSkills.map((skill: string, index: number) => (
              <>
                <span class="hero-tech-item">{skill}</span>
                {index < skills.length - 1 && <span class="hero-tech-separator">·</span>}
              </>
            ))}
          </div>
        </div>
      </div>

      <!-- Optional: Decorative Elements -->
      <div class="hero-decoration" aria-hidden="true">
        <div class="hero-blob hero-blob-1"></div>
        <div class="hero-blob hero-blob-2"></div>
      </div>
    </div>
  </Container>
</section>

<style>
@reference "../../styles/global.css";
  .hero-section {
    @apply relative overflow-hidden isolate;
    background:
      radial-gradient(
        1200px 500px at 50% -10%,
        color-mix(in srgb, theme(--color-eucalyptus-500) 12%, transparent),
        transparent 60%
      ),
      linear-gradient(180deg, color-mix(in srgb, var(--bg-primary) 92%, transparent), var(--bg-primary));
  }

  .hero-shell {
    @apply relative @container rounded-3xl border p-6 @md:p-10 @lg:p-14;
    @apply backdrop-blur-2xl;
    border-color: color-mix(in srgb, var(--border-color) 30%, transparent);
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--bg-elevated) 80%, transparent),
      color-mix(in srgb, var(--bg-elevated) 60%, transparent)
    );
    box-shadow: 
      0 20px 50px -12px rgba(0, 0, 0, 0.1),
      0 10px 10px -5px rgba(0, 0, 0, 0.04),
      inset 0 1px 1px rgba(255, 255, 255, 0.1);
  }

  :global(.dark) .hero-shell {
    border-color: rgba(255, 255, 255, 0.08);
    background: linear-gradient(
      145deg,
      rgba(30, 30, 30, 0.4),
      rgba(15, 15, 15, 0.6)
    );
    box-shadow: 
      0 20px 50px rgba(0, 0, 0, 0.5),
      inset 0 1px 1px rgba(255, 255, 255, 0.05);
  }

  .hero-content {
    @apply relative z-10;
    @apply text-center;
    animation-name: fadeIn;
    animation-duration: 0.8s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
  }

  /* Hero Banner (Wide) */
  .hero-banner-wrapper {
    @apply w-full mb-8 md:mb-10;
    @apply flex justify-center;
  }

  .hero-banner {
    @apply w-full max-w-5xl;
    @apply rounded-2xl border;
    border-color: rgba(255, 255, 255, 0.1);
    @apply shadow-2xl;
    @apply object-cover;
    animation-name: scaleIn;
    animation-duration: 1s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
    max-height: 420px;
    height: auto;
  }

  @keyframes scaleIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Badge */
  .hero-badge {
    @apply inline-flex items-center gap-2 mb-5;
    @apply px-4 py-2 rounded-full;
    @apply bg-eucalyptus-100 dark:bg-eucalyptus-900;
    @apply text-eucalyptus-800 dark:text-eucalyptus-200;
    @apply text-sm font-medium;
  }

  .hero-badge-dot {
    @apply w-2 h-2 rounded-full;
    @apply bg-eucalyptus-600 dark:bg-eucalyptus-400;
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  /* Title */
  .hero-title {
    @apply text-4xl sm:text-5xl md:text-6xl lg:text-7xl;
    @apply font-bold mb-5 tracking-tight;
    @apply text-text-primary-light dark:text-text-primary-dark;
    line-height: 1.1;
  }

  /* Accent Line - Eucalyptus Visual Hierarchy */
  .hero-accent-line {
    @apply w-24 h-1 mx-auto mb-5;
    @apply rounded-full;
    background: linear-gradient(
      90deg,
      theme(--color-eucalyptus-500) 0%,
      theme(--color-eucalyptus-600) 50%,
      theme(--color-eucalyptus-700) 100%
    );
    animation: expandLine 0.8s ease-out 0.3s both;
  }

  @keyframes expandLine {
    from {
      width: 0;
      opacity: 0;
    }
    to {
      width: 6rem;
      opacity: 1;
    }
  }

  :global(.dark) .hero-accent-line {
    background: linear-gradient(
      90deg,
      theme(--color-eucalyptus-400) 0%,
      theme(--color-eucalyptus-500) 50%,
      theme(--color-eucalyptus-600) 100%
    );
  }

  /* Subtitle */
  .hero-subtitle {
    @apply text-2xl sm:text-3xl md:text-4xl;
    @apply font-semibold mb-5;
  }

  /* Description */
  .hero-description {
    @apply text-base sm:text-lg md:text-xl;
    @apply text-text-secondary-light dark:text-text-secondary-dark;
    @apply max-w-3xl mx-auto mb-8 px-4 leading-relaxed;
    line-height: 1.6;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  /* CTA Group */
  .hero-cta-group {
    @apply flex flex-col sm:flex-row items-center justify-center gap-4;
    @apply mb-12;
  }

  /* Tech Stack */
  .hero-tech-stack {
    @apply flex flex-col items-center gap-2;
    @apply text-sm;
  }

  .hero-tech-label {
    @apply text-text-tertiary-light dark:text-text-tertiary-dark;
    @apply font-medium uppercase tracking-wide;
  }

  .hero-tech-icons {
    @apply flex flex-wrap items-center justify-center gap-2 sm:gap-3;
    @apply text-text-secondary-light dark:text-text-secondary-dark;
    @apply max-w-full px-4;
  }

  .hero-tech-item {
    @apply font-medium;
  }

  .hero-tech-separator {
    @apply text-text-tertiary-light dark:text-text-tertiary-dark;
  }

  /* Decorative Blobs */
  .hero-decoration {
    @apply absolute inset-0 z-0 pointer-events-none;
    @apply opacity-20;
  }

  .hero-blob {
    @apply absolute rounded-full;
    @apply bg-gradient-to-br from-eucalyptus-400 to-eucalyptus-600;
    filter: blur(72px);
    animation: float 20s ease-in-out infinite;
  }

  .hero-blob-1 {
    @apply w-96 h-96;
    top: -10%;
    right: -5%;
    animation-delay: 0s;
  }

  .hero-blob-2 {
    @apply w-80 h-80;
    bottom: -10%;
    left: -5%;
    animation-delay: 10s;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(30px, -30px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
  }

  /* Gradient Text - Eucalyptus Theme */
  .text-gradient {
    @apply bg-clip-text text-transparent;
    background-image: linear-gradient(
      135deg,
      theme(--color-eucalyptus-600) 0%,
      theme(--color-eucalyptus-700) 50%,
      theme(--color-eucalyptus-800) 100%
    );
  }

  :global(.dark) .text-gradient {
    background-image: linear-gradient(
      135deg,
      theme(--color-eucalyptus-300) 0%,
      theme(--color-eucalyptus-400) 50%,
      theme(--color-eucalyptus-500) 100%
    );
  }

  /* Dark mode adjustments */
  :global(.dark) .hero-blob {
    @apply opacity-10;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-badge-dot,
    .hero-accent-line,
    .hero-blob,
    .hero-banner {
      animation: none !important;
    }
  }
</style>
