---
// Pagefind Search Component
// Provides static search functionality for blog posts
---

<div id="search" class="search-container">
  <div class="search-wrapper">
    <div id="pagefind-search" class="pagefind-ui"></div>
  </div>
</div>

<script>
  // Import Pagefind UI dynamically after page load
  window.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('pagefind-search');

    const script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.type = 'module';
    script.onload = () => {
      // Pagefind's generated UI never sets an id/name/aria-label on its <input>, so the
      // placeholder was its only (insufficient) accessible name; its result-count message
      // has no aria-live, so updates go unannounced to screen readers. Set both directly on
      // the real elements as Pagefind mounts them, instead of a static <label for> (which
      // would sit in the DOM pointing at nothing during the load window, itself an a11y
      // fault) or forking/patching the generated dist output. The observer must be armed
      // BEFORE PagefindUI runs: its Svelte component mounts synchronously inside the
      // constructor, so a mutation observed only afterward would miss that first insertion.
      // It stays connected for the page's lifetime (not disconnected after the first fix)
      // because Svelte recreates the result-count <p> as a fresh node on every keystroke
      // rather than mutating it in place, so a one-shot fix would only survive until the
      // first search.
      // ponytail: assumes one <Search /> per page (true today); a second instance on the
      // same page would need a distinct container id to avoid a duplicate #search-input.
      if (container) {
        const observer = new MutationObserver(() => {
          const input = container.querySelector('input.pagefind-ui__search-input');
          if (input && !input.id) {
            input.id = 'search-input';
            input.setAttribute('name', 'search');
            input.setAttribute('aria-label', 'Search blog posts');
          }
          const message = container.querySelector('.pagefind-ui__message');
          if (message && !message.hasAttribute('aria-live')) {
            message.setAttribute('role', 'status');
            message.setAttribute('aria-live', 'polite');
          }
        });
        observer.observe(container, { childList: true, subtree: true });
      }

      // @ts-ignore - PagefindUI is loaded dynamically
      new window.PagefindUI({
        element: '#pagefind-search',
        showSubResults: true,
        showImages: false,
        excerptLength: 15,
        translations: {
          placeholder: 'Search blog posts...',
          zero_results: 'No results for [SEARCH_TERM]',
        },
      });
    };
    document.head.appendChild(script);

    // Load Pagefind CSS
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = '/pagefind/pagefind-ui.css';
    document.head.appendChild(link);
  });
</script>

<style>
  .search-container {
    width: 100%;
    margin: 2rem 0;
  }

  .search-wrapper {
    max-width: 48rem;
    margin: 0 auto;
  }

  /* Pre-allocate space for the Pagefind UI input so it doesn't cause CLS
     when PagefindUI.init() runs on DOMContentLoaded (input height ≈ 56px). */
  #pagefind-search {
    min-height: 56px;
  }

  /* Custom Pagefind UI styling to match eucalyptus theme */
  :global(.pagefind-ui__search-input) {
    border: 2px solid var(--color-eucalyptus-500);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    transition: all 0.2s;
  }

  :global(.pagefind-ui__search-input:focus) {
    outline: none;
    border-color: var(--color-eucalyptus-600);
    box-shadow: 0 0 0 3px var(--color-eucalyptus-100);
  }

  :global(.pagefind-ui__result-link) {
    color: var(--color-eucalyptus-700);
    font-weight: 600;
  }

  :global(.pagefind-ui__result-link:hover) {
    color: var(--color-eucalyptus-800);
  }

  :global(.pagefind-ui__result-excerpt mark) {
    background-color: var(--color-eucalyptus-100);
    color: var(--color-eucalyptus-900);
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
  }

  /* Dark mode support */
  :global([data-theme='dark'] .pagefind-ui__search-input) {
    background-color: var(--color-dark-surface);
    border-color: var(--color-eucalyptus-400);
    color: var(--color-text-primary-dark);
  }

  :global([data-theme='dark'] .pagefind-ui__result-link) {
    color: var(--color-eucalyptus-300);
  }

  :global([data-theme='dark'] .pagefind-ui__result-excerpt mark) {
    background-color: var(--color-eucalyptus-800);
    color: var(--color-eucalyptus-100);
  }
</style>
