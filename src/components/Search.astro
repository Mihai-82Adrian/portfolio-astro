---
// Pagefind Search Component
// Provides static search functionality for blog posts
---

<div id="search" class="search-container">
  <div class="search-wrapper">
    <div id="pagefind-search" class="pagefind-ui"></div>
  </div>
</div>

<script>
  // Import Pagefind UI dynamically after page load
  window.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('pagefind-search');

    const script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.type = 'module';
    script.onload = () => {
      // Pagefind's generated UI never sets an id/name/aria-label on its <input>, so the
      // placeholder was its only (insufficient) accessible name; its result-count message
      // has no aria-live, so updates go unannounced to screen readers. Set both directly on
      // the real elements as Pagefind mounts them, instead of a static <label for> (which
      // would sit in the DOM pointing at nothing during the load window, itself an a11y
      // fault) or forking/patching the generated dist output. The observer must be armed
      // BEFORE PagefindUI runs: its Svelte component mounts synchronously inside the
      // constructor, so a mutation observed only afterward would miss that first insertion.
      // It stays connected for the page's lifetime (not disconnected after the first fix)
      // because Svelte recreates the result-count <p> as a fresh node on every keystroke
      // rather than mutating it in place, so a one-shot fix would only survive until the
      // first search.
      // ponytail: assumes one <Search /> per page (true today); a second instance on the
      // same page would need a distinct container id to avoid a duplicate #search-input.
      if (container) {
        const observer = new MutationObserver(() => {
          const input = container.querySelector('input.pagefind-ui__search-input');
          if (input && !input.id) {
            input.id = 'search-input';
            input.setAttribute('name', 'search');
            input.setAttribute('aria-label', 'Search blog posts');
          }
          const message = container.querySelector('.pagefind-ui__message');
          if (message && !message.hasAttribute('aria-live')) {
            message.setAttribute('role', 'status');
            message.setAttribute('aria-live', 'polite');
          }
        });
        observer.observe(container, { childList: true, subtree: true });
      }

      // @ts-ignore - PagefindUI is loaded dynamically
      new window.PagefindUI({
        element: '#pagefind-search',
        showSubResults: true,
        showImages: false,
        excerptLength: 15,
        translations: {
          placeholder: 'Search blog posts...',
          zero_results: 'No results for [SEARCH_TERM]',
        },
      });
    };
    document.head.appendChild(script);

    // Load Pagefind CSS
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = '/pagefind/pagefind-ui.css';
    document.head.appendChild(link);
  });
</script>

<style>
@reference "../styles/global.css";
  .search-container {
    width: 100%;
    margin: 2rem 0;
  }

  .search-wrapper {
    max-width: 48rem;
    margin: 0 auto;
  }

  /* Pre-allocate space for the Pagefind UI input so it doesn't cause CLS
     when PagefindUI.init() runs on DOMContentLoaded (input height ≈ 56px). */
  #pagefind-search {
    min-height: 56px;
  }

  /* Custom Pagefind UI styling to match eucalyptus theme.
     Prefixed with the stable #pagefind-search container id (this component's own markup, id="pagefind-search")
     rather than a bare .pagefind-ui__* class: Pagefind's own generated CSS scopes its defaults with a
     Svelte build-hash class (e.g. .pagefind-ui__search-input.svelte-e9gkc3, .pagefind-ui__result-link
     stacked with .svelte-j9e30 twice on a compound descendant selector), which outranks a single bare
     class by CSS specificity regardless of source order. An ID always outranks any number of classes,
     so this stays correct across Pagefind version bumps without depending on its internal hash.

     Colors applied via Tailwind @apply utilities (border-eucalyptus-500 etc.), not
     var(--color-eucalyptus-*)/var(--color-dark-*)/var(--color-text-*-dark) custom properties: this
     project's Tailwind v4 + legacy `@config` setup (see global.css's `@import "tailwindcss"; @config
     "../../tailwind.config.mjs";`) never emits CSS custom properties for palette entries defined only
     in tailwind.config.mjs's theme.extend.colors — confirmed by compiling and grepping the full
     dist/ output for these exact names (zero matches; only Tailwind's own built-in default palette
     ships pre-defined --color-* variables). A bare var(--color-eucalyptus-500) reference is therefore
     an undefined-custom-property bug of the same class as CSS-UNDEFINED-VARS-P1, silently collapsing
     to the initial value. See TAILWIND_V4_LEGACY_CONFIG_CSS_VAR_GAP.md (repo-wide inventory,
     out of this phase's scope beyond this file). box-shadow below uses Tailwind's theme() CSS
     function (resolved to the real token value at build time, not a hardcoded hex) rather than an
     @apply utility: Tailwind's ring-* utilities use a different --tw-ring-* stacking mechanism that
     would change this glow's rendering semantics, not a safe drop-in for a plain color swap. */
  :global(#pagefind-search .pagefind-ui__search-input) {
    border: 2px solid;
    @apply border-eucalyptus-500;
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    transition: all 0.2s;
  }

  :global(#pagefind-search .pagefind-ui__search-input:focus) {
    outline: none;
    @apply border-eucalyptus-600;
    box-shadow: 0 0 0 3px theme(--color-eucalyptus-100);
  }

  :global(#pagefind-search .pagefind-ui__result-link) {
    @apply text-eucalyptus-700;
    font-weight: 600;
  }

  :global(#pagefind-search .pagefind-ui__result-link:hover) {
    @apply text-eucalyptus-800;
  }

  :global(#pagefind-search .pagefind-ui__result-excerpt mark) {
    @apply bg-eucalyptus-100 text-eucalyptus-900;
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
  }

  /* Dark mode support (class-based, aligned with site theme toggle).

     Pagefind's own generated CSS (dist/pagefind/pagefind-ui.css) themes itself through a small,
     real, documented custom-property contract: `.pagefind-ui{color:var(--pagefind-ui-text)}` is
     the single inheritance root every un-styled descendant (the result-count message, normal
     excerpt body text, sub-result title/excerpt text, the loading indicator, the search-clear
     control, and the "Load more results" button) falls back to. Only three leaf elements
     (search input, result link, highlighted <mark>) had their own explicit color/background
     override below — everything else silently kept Pagefind's own never-overridden light-theme
     default value for `--pagefind-ui-text` (a dark grey — see PAGEFIND_THEME_CONTRACT.md for the
     literal value), which reads as near-illegible against this project's dark page background.
     Setting the four color-bearing Pagefind variables
     here, once, on the container, themes every current and future un-styled descendant through
     Pagefind's own contract — not a per-Svelte-node selector — using this project's existing
     runtime semantic tokens (already switch under .dark; not the undefined Tailwind names this
     file used to reference, see TAILWIND_V4_LEGACY_CONFIG_CSS_VAR_GAP.md). Light mode is
     untouched (no rule outside .dark), so Pagefind's already-correct light appearance cannot
     regress. */
  :global(.dark #pagefind-search) {
    --pagefind-ui-text: var(--text-primary);
    --pagefind-ui-background: var(--bg-surface);
    --pagefind-ui-border: var(--border-color);
    --pagefind-ui-primary: var(--color-primary);
  }

  :global(.dark #pagefind-search .pagefind-ui__search-input) {
    @apply bg-dark-surface border-eucalyptus-400 text-text-primary-dark;
  }

  :global(.dark #pagefind-search .pagefind-ui__result-link) {
    @apply text-eucalyptus-300;
  }

  :global(.dark #pagefind-search .pagefind-ui__result-excerpt mark) {
    @apply bg-eucalyptus-800 text-eucalyptus-100;
  }
</style>
