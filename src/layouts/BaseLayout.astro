---
/**
 * Base Layout Component
 *
 * Provides the foundation for all pages:
 * - HTML structure with proper meta tags
 * - Global CSS imports
 * - Theme initialization (prevents flash)
 * - Responsive viewport settings
 * - SEO-friendly defaults
 * - Multilingual support (DE/EN/RO)
 * - hreflang tags for language variants
 * - Pagefind indexing (data-pagefind-body)
 */

import { ClientRouter } from 'astro:transitions';
import { themeScript } from '@/utils/theme';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import type { Language } from '@utils/i18n';
import { getRouteAlternateUrls, getSingleLanguageRoute, normalizeSiteUrl } from '@utils/i18n';
import '@/styles/global.css';
import tokens from '@/data/design-tokens.json';
import ChatDrawer from '@components/ChatDrawer.astro';
import CookieConsent from '@components/common/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonicalURL?: string;
  alternates?: Record<string, string>;
  lang?: Language;
  noindex?: boolean;
  structuredData?: Record<string, any>;
  math?: boolean;
  hideChatDrawer?: boolean;
}

const {
  title = 'Mihai Adrian Mateescu',
  description = 'Finanzbuchhalter & FinTech-Entwickler im DACH-Raum. FinTech-Tools, Buchhaltungsautomatisierung und AI-gestützte Webentwicklung für Gründer und Freelancer.',
  ogImage = '/images/og-default.webp',
  ogType = 'website',
  canonicalURL,
  alternates,
  lang: langProp,
  noindex = false,
  structuredData,
  math = false,
  hideChatDrawer = false,
} = Astro.props;

const siteTitle = 'Mihai Adrian Mateescu';

// Prefer Astro.site (from astro.config.mjs `site:`), fallback to hard-coded
const siteUrl =
  (Astro.site?.href?.replace(/\/$/, '') ?? 'https://me-mateescu.de');

const currentPath = Astro.url.pathname;
const isServicesRoute = new Set([
  '/services',
  '/services/',
  '/en/services',
  '/en/services/',
  '/ro/services',
  '/ro/services/',
]).has(currentPath);

// Route-language policy (Phase 2D-C Wave 1, src/utils/i18n.ts): routes that exist
// intentionally in a single language (Blog, Tools, /now, /ai, /projects) never infer
// their language from a /en//ro/ path prefix, since none of them use one.
const singleLanguageRoute = getSingleLanguageRoute(currentPath);

// Infer language from pathname if not explicitly passed via props
const inferredLang: Language =
  singleLanguageRoute ??
  (currentPath.startsWith('/en') ? 'en' :
  currentPath.startsWith('/ro') ? 'ro' :
  'de');

const lang: Language = langProp ?? inferredLang;

// Canonical should be stable (production origin), allow override from props
const canonicalHref = normalizeSiteUrl(canonicalURL ?? new URL(currentPath, siteUrl).href);

// Avoid double-appending if the title already contains the site name
const fullTitle =
  title === siteTitle || title.includes(siteTitle)
    ? title
    : `${title} | ${siteTitle}`;
const fullImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Generate alternate language URLs. Locked single-language routes (Blog, Tools,
// /now, /ai, /projects — see src/utils/i18n.ts) emit only their real language +
// x-default; every other route uses full DE/EN/RO path-substitution.
const alternateUrls = Object.fromEntries(
  Object.entries(alternates ?? getRouteAlternateUrls(currentPath, siteUrl)).map(([hreflang, url]) => [
    hreflang,
    normalizeSiteUrl(url as string),
  ])
);

const ogLocale =
  lang === 'de' ? 'de_DE' :
  lang === 'en' ? 'en_GB' :
  'ro_RO';

// Default structured data (Person schema)
const defaultStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Mihai Adrian Mateescu",
  "givenName": "Mihai Adrian",
  "familyName": "Mateescu",
  "jobTitle": lang === 'de' ? 'Finanzbuchhalter' : lang === 'en' ? 'Financial Accountant' : 'Contabil Financiar',
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Seevetal",
    "postalCode": "21218",
    "streetAddress": "Bahnhofstraße 65b",
    "addressCountry": "DE"
  },
  "email": "kontakt@me-mateescu.de",
  "telephone": "+491704740121",
  "url": siteUrl,
  "sameAs": [
    "https://www.linkedin.com/in/mihai-adrian-mateescu/"
  ],
  "knowsLanguage": ["de", "en", "ro"]
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Mihai Adrian Mateescu" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow" />}

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalHref} />
    <link rel="alternate" type="application/rss+xml" title="Mihai Adrian Mateescu RSS Feed" href={`${siteUrl}/rss.xml`} />
    <link rel="alternate" type="application/atom+xml" title="Mihai Adrian Mateescu Atom Feed" href={`${siteUrl}/atom.xml`} />

    <!-- Alternate Language Links (hreflang) -->
    {Object.entries(alternateUrls).map(([hreflang, url]) => (
      <link rel="alternate" hreflang={hreflang} href={url} />
    ))}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@mihaimateescu_de" />
    <meta name="twitter:creator" content="@mihaimateescu_de" />
    <meta name="twitter:url" content={canonicalHref} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Favicons -->
    <link rel="icon" href="/images/favicon.ico" sizes="any" />
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="mask-icon" href="/images/safari-pinned-tab.svg" color={tokens.colors.eucalyptus[500]} />

    <!-- Theme Color (matches eucalyptus green) -->
    <meta name="theme-color" content={tokens.colors.eucalyptus[500]} />
    <meta name="msapplication-TileColor" content={tokens.colors.eucalyptus[500]} />

    <!-- Web Manifest -->
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Structured Data (JSON-LD) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData || defaultStructuredData)}
    />

    <!-- KaTeX CSS: only loaded on pages with mathematical content -->
    {math && <link rel="stylesheet" href="/katex/katex.min.css" />}

    <!-- Fonts: self-hosted via Fontsource (inlined into global.css, served from same CDN) -->

    <!-- Theme initialization (inline to prevent flash) -->
    <script is:inline set:html={themeScript} />

    <!-- Client Router: SPA-like navigation -->
    <ClientRouter />

    <!--
      Optional analytics, opt-in only. Neither script tag below is rendered
      here — each is injected client-side, only after the matching consent
      channel in src/lib/consent.ts. See src/components/common/CookieConsent.astro
      for the consent UI.

      Cloudflare Web Analytics (RUM) is embedded manually here — instead of
      relying on Cloudflare's platform-level automatic injection — so it can
      be withheld until performance-analytics consent. It uses the project's
      existing Cloudflare Web Analytics site token (not a new property).
    -->
    <script>
      import { readPreferences, CONSENT_CHANGE_EVENT, type PrivacyPreferences } from '@/lib/consent';

      const CF_BEACON_SCRIPT_ID = 'cloudflare-rum-beacon';
      const CF_BEACON_TOKEN = 'd1cc49108d8241e184c27be91b026fcf';

      const AHREFS_SCRIPT_ID = 'ahrefs-analytics';
      const AHREFS_KEY = 'TaG4/LHrEhmbalis3ebSqA';

      function loadCloudflareRum() {
        if (document.getElementById(CF_BEACON_SCRIPT_ID)) return;
        const script = document.createElement('script');
        script.id = CF_BEACON_SCRIPT_ID;
        script.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        script.dataset.cfBeacon = JSON.stringify({ token: CF_BEACON_TOKEN });
        script.async = true;
        script.onerror = () => {
          // Non-blocking: a failed or blocked beacon must never affect the site.
        };
        document.head.appendChild(script);
      }

      function loadAhrefs() {
        if (document.getElementById(AHREFS_SCRIPT_ID)) return;
        const script = document.createElement('script');
        script.id = AHREFS_SCRIPT_ID;
        script.src = 'https://analytics.ahrefs.com/analytics.js';
        script.dataset.key = AHREFS_KEY;
        script.async = true;
        script.onerror = () => {
          // Non-blocking: a failed or blocked script must never affect the site.
        };
        document.head.appendChild(script);
      }

      function applyPreferences(prefs: PrivacyPreferences) {
        if (prefs.performanceAnalytics.cloudflareRum) loadCloudflareRum();
        if (prefs.acquisitionAnalytics.ahrefs) loadAhrefs();
        // A script that already started executing cannot be un-loaded — later
        // withdrawal (CookieConsent.astro) triggers a full reload instead of
        // relying on this listener to stop anything already running.
      }

      applyPreferences(readPreferences(window.localStorage));
      window.addEventListener(CONSENT_CHANGE_EVENT, (event) => {
        applyPreferences((event as CustomEvent<PrivacyPreferences>).detail);
      });
    </script>
  </head>

  <body class="min-h-screen bg-light-bg dark:bg-dark-bg text-text-primary-light dark:text-text-primary-dark antialiased transition-colors duration-300">
    <!-- Skip to main content link (WCAG 2.2 AAA) -->
    <a
      href="#main-content"
      class="skip-link sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-eucalyptus-600 focus:text-white focus:rounded-md focus:shadow-lg focus:ring-2 focus:ring-eucalyptus-500 focus:ring-offset-2"
    >
      {lang === 'de' ? 'Zum Hauptinhalt springen' : lang === 'en' ? 'Skip to main content' : 'Sari la conținutul principal'}
    </a>

    <!-- Header: keep out of Pagefind index (optional safety) -->
    <div data-pagefind-ignore>
      <Header currentPath={currentPath} />
    </div>

    <!-- ✅ Pagefind body scope: once this exists anywhere, other pages need it too -->
    <main
      id="main-content"
      class="pt-0"
      data-pagefind-body
    >
      <slot />
    </main>

    <!-- Footer: keep out of Pagefind index (optional safety) -->
    <div data-pagefind-ignore>
      <Footer lang={lang} />
    </div>
    <!-- AI Chat Drawer (Global, excluded on Services routes) -->
    {!isServicesRoute && !hideChatDrawer && <ChatDrawer lang={lang} />}
    <CookieConsent lang={lang} privacyPolicyUrl={lang === 'de' ? '/datenschutz' : `/${lang}/datenschutz`} />

    <!-- Re-apply persisted theme after client-side route transitions -->
    <script is:inline>
      (() => {
        const applyStoredTheme = () => {
          const storedTheme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const shouldBeDark = storedTheme === 'dark' || (!storedTheme && prefersDark);
          document.documentElement.classList.toggle('dark', shouldBeDark);
        };

        applyStoredTheme();
        document.addEventListener('astro:after-swap', applyStoredTheme);
        document.addEventListener('astro:page-load', applyStoredTheme);
      })();
    </script>
  </body>
</html>
