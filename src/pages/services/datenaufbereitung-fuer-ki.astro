---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { generateBreadcrumbSchema } from '@utils/structuredData';
import {
  dataPrepLandingContent,
} from '@data/services/data-prep-for-ai';
import HeroSection from '@components/services/data-prep/HeroSection.astro';
import ProblemSection from '@components/services/data-prep/ProblemSection.astro';
import ServicesSection from '@components/services/data-prep/ServicesSection.astro';
import OutputsSection from '@components/services/data-prep/OutputsSection.astro';
import ProcessSection from '@components/services/data-prep/ProcessSection.astro';
import TrustSection from '@components/services/data-prep/TrustSection.astro';
import FaqSection from '@components/services/data-prep/FaqSection.astro';
import PricingSection from '@components/services/data-prep/PricingSection.astro';
import FinalCtaSection from '@components/services/data-prep/FinalCtaSection.astro';

const { seo, hero, problem, services, outputs, process, trust, faq, pricing, finalCta } =
  dataPrepLandingContent;
const canonicalURL = 'https://me-mateescu.de/services/datenaufbereitung-fuer-ki';

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: 'https://me-mateescu.de/' },
  { name: 'Services', url: 'https://me-mateescu.de/services' },
  { name: 'Datenaufbereitung für KI', url: canonicalURL },
]);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  canonicalURL={canonicalURL}
  lang="de"
  structuredData={breadcrumbSchema}
>
  <main class="pb-20">
    <HeroSection content={hero} />
    <ProblemSection content={problem} />
    <ServicesSection content={services} />
    <OutputsSection content={outputs} />
    <ProcessSection content={process} />
    <TrustSection content={trust} />
    <FaqSection content={faq} />
    <PricingSection content={pricing} />
    <FinalCtaSection content={finalCta} />
  </main>
</BaseLayout>
