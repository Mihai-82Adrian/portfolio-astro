---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import Link from '@components/ui/Link.astro';

const title = 'Seite nicht gefunden';
const description = 'Die angeforderte Seite wurde nicht gefunden. Zurück zur Startseite oder direkt zu Services, Projekten und Tools.';
---

<BaseLayout title={title} description={description} lang="de" noindex={true}>
  <section class="mx-auto flex w-full max-w-4xl flex-col items-center px-4 py-20 text-center sm:px-6 md:py-24" aria-labelledby="not-found-title" data-pagefind-ignore="all">
    <p class="font-mono text-sm font-semibold tracking-widest text-eucalyptus-700 dark:text-eucalyptus-300">
      Fehler 404
    </p>
    <h1 id="not-found-title" class="mt-4 text-balance text-4xl font-bold leading-tight text-text-primary-light dark:text-text-primary-dark sm:text-5xl">
      Diese Seite wurde nicht gefunden
    </h1>
    <p class="mt-5 max-w-2xl text-pretty text-base leading-relaxed text-text-secondary-light dark:text-text-secondary-dark sm:text-lg">
      Die Adresse ist möglicherweise nicht mehr aktuell oder wurde falsch eingegeben.
    </p>

    <div class="mt-8">
      <Button href="/" size="lg">Zur Startseite</Button>
    </div>

    <nav class="mt-10 rounded-2xl border border-black/10 bg-[var(--bg-elevated)] px-6 py-5 dark:border-white/10" aria-label="Hilfreiche Seiten">
      <p class="text-sm font-semibold text-text-primary-light dark:text-text-primary-dark">Oder direkt weiter zu</p>
      <ul class="mt-3 flex flex-wrap justify-center gap-x-6 gap-y-3">
        <li><Link href="/services/">Services</Link></li>
        <li><Link href="/projects/">Projekte</Link></li>
        <li><Link href="/tools/">Tools</Link></li>
      </ul>
    </nav>

    <p class="mt-8 max-w-2xl text-pretty text-sm leading-relaxed text-text-muted-light dark:text-text-muted-dark">
      <span lang="en">The requested page could not be found.</span>
      <span aria-hidden="true"> · </span>
      <span lang="ro">Pagina solicitată nu a fost găsită.</span>
    </p>
  </section>
</BaseLayout>
