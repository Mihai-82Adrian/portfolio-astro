---
/**
 * Homepage - Mihai Adrian Mateescu Portfolio
 *
 * Main landing page with professional overview,
 * skills summary, and links to main sections
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@components/sections/Hero.astro';
import BentoGrid from '@components/sections/BentoGrid.astro';
import Container from '@components/ui/Container.astro';
import Card from '@components/ui/Card.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import { translations } from '@data/translations';
import { generatePersonSchema, generateWebSiteSchema } from '@utils/structuredData';

const lang = 'de';
const t = translations[lang];

const title = 'Finanzbuchhalter & KI-Entwickler';
const seoDescription = 'Finanzbuchhalter & KI-Enthusiast im DACH-Raum. FinTech-Tools, Buchhaltungsautomatisierung und KI-gestützte Webentwicklung für Gründer und Freelancer.';
const dataPrepTeaser = {
  title: 'Neu: KI-Datenaufbereitung für Finance-Workflows',
  body: 'Eine eigenständige Landing Page für Teams, die PDFs, ERP-Exporte, XML und Compliance-Daten in saubere, strukturierte und KI-verwertbare Ergebnisse überführen müssen.',
  primaryLabel: 'Zur Landing Page',
  primaryHref: '/datenaufbereitung-fuer-ki',
  secondaryLabel: 'Discovery Call',
  secondaryHref: '/discovery-call',
};

// Generate structured data for homepage
const personSchema = generatePersonSchema(lang);
const websiteSchema = generateWebSiteSchema(lang);
const structuredData = [personSchema, websiteSchema];
---

<BaseLayout title={title} description={seoDescription} lang={lang} structuredData={structuredData}>
  <!-- Hero Section -->
  <Hero
    lang={lang}
    title={t.home.title}
    subtitle={t.home.subtitle}
    description={t.home.description}
    skillsLabel={t.home.skillsLabel}
    skills={t.home.heroSkills}
    imageSrc="/images/2025-2_50PM.webp"
    imageAlt="Mihai Adrian Mateescu"
    badgeText={t.home.availabilityBadge}
  >
    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
      <Button href="/experience" variant="primary" size="lg">
        {t.nav.experience}
      </Button>
      <Button href="/blog" variant="secondary" size="lg">
        {t.nav.blog}
      </Button>
      <Button href="#contact" variant="outline" size="lg">
        {t.nav.contact}
      </Button>
    </div>
  </Hero>

  <!-- Contact Information & Quick Links -->
  <Container>
    <!-- Strategic Offer -->
    <section class="py-12">
      <Card>
        <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-eucalyptus-700 dark:text-eucalyptus-300">
              {t.home.dataPrepTeaser.label}
            </p>
            <h2 class="mt-3 text-3xl font-bold text-text-primary-light dark:text-text-primary-dark text-balance">
              {t.home.dataPrepTeaser.title}
            </h2>
            <p class="mt-4 max-w-3xl text-text-secondary-light dark:text-text-secondary-dark text-pretty transition-all hover:text-text-primary-light dark:hover:text-text-primary-dark">
              {t.home.dataPrepTeaser.body}
            </p>
          </div>
          <div class="flex flex-col gap-3 lg:items-end">
            <Button href={dataPrepTeaser.primaryHref} variant="primary" size="lg">
              {t.home.dataPrepTeaser.primaryLabel}
            </Button>
            <Button href={dataPrepTeaser.secondaryHref} variant="outline" size="lg">
              {t.home.dataPrepTeaser.secondaryLabel}
            </Button>
          </div>
        </div>
      </Card>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-12">
      <Card>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <h2 class="text-2xl font-bold text-text-primary-light dark:text-text-primary-dark mb-6 text-balance">
              {t.contact.address}
            </h2>
            <p class="text-text-secondary-light dark:text-text-secondary-dark text-pretty leading-relaxed">
              Bahnhofstraße 65b<br />
              21218 Seevetal<br />
              Germany
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-bold text-text-primary-light dark:text-text-primary-dark mb-6 text-balance">
              {t.contact.heading}
            </h2>
            <div class="space-y-4 text-text-secondary-light dark:text-text-secondary-dark">
              <p class="flex items-center gap-2">
                <Icon name="phone" class="h-4 w-4 text-eucalyptus-600 dark:text-eucalyptus-400" />
                <strong>{t.contact.phone}:</strong>{' '}
                <a href="tel:+491704740121" class="text-eucalyptus-800 dark:text-eucalyptus-200 underline decoration-eucalyptus-600/30 dark:decoration-eucalyptus-400/30 hover:decoration-eucalyptus-700 dark:hover:decoration-eucalyptus-300 transition-all">
                  +49 170 474 0121
                </a>
              </p>
              <p class="flex items-center gap-2">
                <Icon name="mail" class="h-4 w-4 text-eucalyptus-600 dark:text-eucalyptus-400" />
                <strong>{t.contact.email}:</strong>{' '}
                <a href="mailto:kontakt@me-mateescu.de" class="text-eucalyptus-800 dark:text-eucalyptus-200 underline decoration-eucalyptus-600/30 dark:decoration-eucalyptus-400/30 hover:decoration-eucalyptus-700 dark:hover:decoration-eucalyptus-300 transition-all">
                  kontakt@me-mateescu.de
                </a>
              </p>
              <p class="flex items-center gap-2">
                <Icon name="linkedin" class="h-4 w-4 text-eucalyptus-600 dark:text-eucalyptus-400" />
                <strong>{t.contact.linkedin}:</strong>{' '}
                <a
                  href="https://www.linkedin.com/in/mihai-adrian-mateescu/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-eucalyptus-800 dark:text-eucalyptus-200 underline decoration-eucalyptus-600/30 dark:decoration-eucalyptus-400/30 hover:decoration-eucalyptus-700 dark:hover:decoration-eucalyptus-300 transition-all"
                >
                  Mateescu Mihai
                </a>
              </p>
            </div>
          </div>
        </div>
      </Card>
    </section>

    <!-- Quick Links -->
    <section class="py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <Card variant="glass" hover>
          <h3 class="text-xl font-semibold text-eucalyptus-700 dark:text-eucalyptus-300 mb-3 text-balance">
            {t.nav.education}
          </h3>
          <p class="text-text-secondary-light dark:text-text-secondary-dark mb-4 text-pretty">
            {t.home.quickLinks.education}
          </p>
          <Button href="/education" variant="ghost" size="sm">
            {t.common.learnMore} →
          </Button>
        </Card>

        <Card variant="glass" hover>
          <h3 class="text-xl font-semibold text-eucalyptus-700 dark:text-eucalyptus-300 mb-3 text-balance">
            {t.nav.experience}
          </h3>
          <p class="text-text-secondary-light dark:text-text-secondary-dark mb-4 text-pretty">
            {t.home.quickLinks.experience}
          </p>
          <Button href="/experience" variant="ghost" size="sm">
            {t.common.learnMore} →
          </Button>
        </Card>

        <Card variant="glass" hover>
          <h3 class="text-xl font-semibold text-eucalyptus-700 dark:text-eucalyptus-300 mb-3 text-balance">
            {t.nav.certifications}
          </h3>
          <p class="text-text-secondary-light dark:text-text-secondary-dark mb-4 text-pretty">
            {t.home.quickLinks.certifications}
          </p>
          <Button href="/certifications" variant="primary" size="sm">
            {t.common.learnMore} →
          </Button>
        </Card>
      </div>
    </section>
  </Container>

  <!-- Overview Hub: Bento Grid (Lowered) -->
  <BentoGrid lang={lang} />

  <Container>
    <!-- Professional Expertise Hub -->
    <section class="py-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Skills Section -->
        <Card variant="glass" hover>
          <h2 class="text-2xl font-bold text-text-primary-light dark:text-text-primary-dark mb-6 text-balance">
            {t.home.skills.title}
          </h2>
          <ul class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-x-6 gap-y-4">
            {t.home.skills.items.map((skill) => (
              <li class="flex items-start">
                <span class="text-eucalyptus-600 dark:text-eucalyptus-400 mr-3 inline-flex pt-1" aria-hidden="true">
                  <Icon name="check-circle" class="h-5 w-5" />
                </span>
                <span class="text-pretty">{skill}</span>
              </li>
            ))}
          </ul>
        </Card>

        <!-- Leadership Section -->
        <Card variant="glass" hover>
          <h2 class="text-2xl font-bold text-text-primary-light dark:text-text-primary-dark mb-6 text-balance">
            {t.home.leadership.title}
          </h2>
          <ul class="space-y-4 text-text-secondary-light dark:text-text-secondary-dark">
            {t.home.leadership.items.map((item) => (
              <li class="flex items-start">
                <span class="text-eucalyptus-600 dark:text-eucalyptus-400 mr-3 inline-flex pt-1" aria-hidden="true">
                  <Icon name="check-circle" class="h-5 w-5" />
                </span>
                <span class="text-pretty">{item}</span>
              </li>
            ))}
          </ul>
        </Card>
      </div>
    </section>

    <!-- Hobbies Teaser -->
    <section class="py-12 text-center">
      <Card variant="glass" hover>
        <h2 class="text-3xl font-bold text-text-primary-light dark:text-text-primary-dark mb-4 text-balance">
          {t.home.hobbies.title}
        </h2>
        <p class="text-text-secondary-light dark:text-text-secondary-dark mb-6 max-w-2xl mx-auto text-pretty">
          {t.home.quickLinks.hobbiesText}
        </p>
        <Button href="/about" variant="primary">
          {t.home.hobbies.learnMore}
        </Button>
      </Card>
    </section>
  </Container>
</BaseLayout>
