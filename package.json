{
  "name": "portfolio-astro",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "predev": "node scripts/sync-katex-assets.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-katex-assets.mjs",
    "build": "node scripts/release/provenance.mjs identity && astro build && node scripts/release/pagefind.mjs",
    "preview": "astro preview",
    "check": "node scripts/release/provenance.mjs identity && astro check",
    "check:contrast": "node scripts/check-contrast.js",
    "check:all": "npm run check && npm run check:contrast",
    "lint:design-system": "node scripts/audit-styles.js",
    "lint:design-system:strict": "node scripts/audit-styles.js --strict",
    "lint:design-system:json": "node scripts/audit-styles.js --json",
    "lint:a11y": "node scripts/scan-structure.mjs && node scripts/scan-dist.mjs",
    "lint:a11y:strict": "node scripts/scan-structure.mjs --strict && node scripts/scan-dist.mjs --strict",
    "lint:chat": "node scripts/lint-chat.js",
    "ci:a11y": "npm run build && npm run lint:a11y:strict",
    "ci:quality": "npm run lint:design-system && npm run lint:chat && npm run check && npm run build",
    "lint:content": "node scripts/audit-content.mjs",
    "verify:content:strict": "npm run lint:content -- --strict",
    "dev:chat": "node scripts/release/provenance.mjs identity && wrangler pages dev dist --compatibility-date=2025-11-14 --live-reload",
    "dev:copilot": "npm run build && npm run dev:chat",
    "astro": "astro",
    "check:corpus": "node scripts/check-corpus.js",
    "check:corpus:strict": "node scripts/check-corpus.js --strict",
    "verify:chat:goldset": "bash scripts/verify-chat-goldset.sh http://localhost:8788 docs/chat-goldset.json",
    "verify:xrechnung:fixtures": "node scripts/verify-xrechnung-fixtures.mjs",
    "kosit:preflight": "node scripts/kosit-preflight.mjs",
    "kosit:setup": "node scripts/kosit-setup.mjs",
    "kosit:validate": "node scripts/kosit-validate.mjs",
    "verify:xrechnung:kosit": "node scripts/verify-xrechnung-kosit.mjs",
    "verify:xrechnung:kosit:offline": "node scripts/verify-xrechnung-kosit.mjs",
    "verify:xrechnung:kosit:tooling": "node --test tests/kosit-tooling.test.mjs",
    "setup:xrechnung:kosit:download": "node scripts/kosit-download.mjs",
    "gen:pap": "node scripts/parse-bmf-pap.ts",
    "verify:pap": "node scripts/verify-pap-generation.mjs",
    "verify:xrechnung:results": "node scripts/verify-xrechnung-results.mjs",
    "verify:reportview-security": "node --test tests/report-markdown.test.mjs",
    "verify:function-contracts": "node --test tests/function-contracts.test.mjs",
    "verify:ai-provider-contracts": "node --test tests/ai-provider-contracts.test.mjs",
    "verify:ai-reliability": "node --test tests/chat-grounding-contract.test.mjs tests/chat-widget-error-copy.test.mjs tests/chat-widget-response-envelope.test.mjs tests/recruiter-injection-resistance.test.mjs tests/recruiter-result-schema.test.mjs tests/chat-widget-accessibility.test.mjs tests/deterministic-intent-matrix.test.mjs",
    "verify:release-orchestrator": "node --test tests/release-orchestrator-contract.test.mjs",
    "verify:finance": "node --test tests/financial/*.test.mjs",
    "verify:privacy": "node --test tests/privacy-boundary.test.mjs",
    "verify:governance": "node --test tests/governance.test.mjs",
    "verify:repo-truth": "node --test tests/repo-truth.test.mjs",
    "verify:route-language-policy": "node --test tests/route-language-policy.test.mjs",
    "verify:no-public-qa-routes": "node --test tests/no-public-qa-routes.test.mjs",
    "verify:route-integrity": "npm run build && node scripts/verify-route-integrity.mjs && node --test tests/ai-route-discoverability.test.mjs tests/homepage-positioning.test.mjs tests/wave5-content-proof.test.mjs",
    "verify:route-integrity:built": "node scripts/verify-route-integrity.mjs && node --test tests/ai-route-discoverability.test.mjs tests/homepage-positioning.test.mjs tests/wave5-content-proof.test.mjs",
    "verify:route-integrity:built:strict": "node scripts/verify-route-integrity.mjs --strict && node --test tests/ai-route-discoverability.test.mjs tests/homepage-positioning.test.mjs tests/wave5-content-proof.test.mjs",
    "verify:route-integrity:extended": "node --test tests/route-integrity-extended.test.mjs",
    "verify:sample-review-disabled": "npm run build && node --test tests/sample-review-disabled-state.test.mjs",
    "verify:sample-review-disabled:built": "node --test tests/sample-review-disabled-state.test.mjs",
    "verify:wave1-launch-truth:built": "npm run verify:route-language-policy && npm run verify:no-public-qa-routes && npm run verify:route-integrity:built:strict && npm run verify:sample-review-disabled:built",
    "verify:pagefind-a11y": "node --test tests/pagefind-accessibility.test.mjs",
    "verify:fintools-persistence": "node --test tests/fintools-persistence-contract.test.mjs",
    "verify:final-product-acceptance": "node --test tests/final-product-acceptance.test.mjs",
    "verify:operational-controls": "node --test tests/operational-controls.test.mjs",
    "verify:dependency-tree": "node scripts/verify-dependency-tree.mjs && node --test tests/dependency-tree.test.mjs",
    "verify:advisory-scanner": "node --test tests/github-advisory-scan.test.mjs",
    "verify:full-suite": "npm run build && node --test tests/*.test.mjs tests/financial/*.test.mjs",
    "build:release-artifacts": "node scripts/release/provenance.mjs build",
    "verify:release-provenance": "node scripts/release/provenance.mjs identity && node --test tests/release-provenance.test.mjs tests/health-contract.test.mjs",
    "verify:csp": "npm run build && node --test tests/csp.test.mjs",
    "verify:markdown-processor": "npm run build && node --test tests/markdown-processor.test.mjs",
    "verify:markdown-processor:built": "node --test tests/markdown-processor.test.mjs",
    "verify:pdf-exports": "node --test tests/pdf-exports.test.mjs",
    "verify:toolchain": "node scripts/release/guards.mjs toolchain",
    "verify:advisory-register": "node scripts/release/guards.mjs advisories",
    "verify:workflows": "node scripts/release/guards.mjs workflows",
    "verify:release-policy": "node scripts/release/guards.mjs policy",
    "verify:public-release-lineage": "node scripts/release/public-lineage.mjs verify",
    "prepare:public-release": "node scripts/release/public-lineage.mjs prepare --dry-run",
    "verify:reproducibility": "node scripts/release/reproducibility.mjs",
    "verify:reproducibility:container": "node scripts/release/reproducibility.mjs --container-only",
    "verify:postdeploy": "node scripts/release/postdeploy.mjs",
    "plan:rollback": "node scripts/release/rollback.mjs",
    "setup:firefox:release": "node scripts/release/setup-firefox.mjs",
    "verify:firefox-release": "node scripts/release/firefox-release.mjs",
    "verify:release-candidate": "node scripts/release/candidate.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.2",
    "@astrojs/svelte": "9.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@lucide/astro": "1.28.0",
    "astro": "7.1.6",
    "chart.js": "^4.5.1",
    "dompurify": "3.4.12",
    "katex": "^0.16.45",
    "marked": "18.0.6",
    "pdfmake": "^0.3.7",
    "svelte": "5.56.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "^25.6.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "jsdom": "29.1.1",
    "node-html-parser": "^9.0.1",
    "pagefind": "1.5.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "4.2.2",
    "terser": "5.46.1",
    "typescript": "^5.7.3",
    "wrangler": "4.114.0"
  }
}
